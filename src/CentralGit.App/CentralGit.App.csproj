<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CentralGit.App</RootNamespace>
    <AssemblyName>CentralGit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/CentralGit.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Plain `dotnet build` of the solution has no platform; default to x64 so it just works. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'"
      >win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: installed per-user by our own setup (Velopack), not MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without this, `dotnet publish` of an unpackaged app leaves out CentralGit.pri and the .xbf files,
         and the installed app dies at startup with 0xC000027B. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs runs Velopack's install/update hooks before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CentralGit.Application\CentralGit.Application.csproj" />
    <ProjectReference Include="..\CentralGit.Domain\CentralGit.Domain.csproj" />
    <!-- The composition root (App.xaml.cs) is the only place that uses it; Architecture.Tests checks. -->
    <ProjectReference Include="..\CentralGit.Infrastructure\CentralGit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Assets/CentralGit.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

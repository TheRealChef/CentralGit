<Window x:Class="CentralGit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CentralGit.App.ViewModels"
        xmlns:graph="using:CentralGit.App.Graph"
        xmlns:diff="using:CentralGit.App.Diff"
        xmlns:controls="using:CentralGit.App.Controls"
        Title="CentralGit">
    <Grid x:Name="Root"
          Background="{ThemeResource WindowBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K"
                                 Modifiers="Control"
                                 Invoked="OnCommandPaletteAccelerator" />
            <KeyboardAccelerator Key="F"
                                 Modifiers="Control"
                                 Invoked="OnFilterAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Key="Down"
                                 Modifiers="Menu"
                                 Invoked="OnNextChangeAccelerator" />
            <KeyboardAccelerator Key="Up"
                                 Modifiers="Menu"
                                 Invoked="OnPreviousChangeAccelerator" />
            <KeyboardAccelerator Key="Left"
                                 Modifiers="Menu"
                                 Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right"
                                 Modifiers="Menu"
                                 Invoked="OnForwardAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <diff:DiffTemplateSelector x:Key="DiffRowSelector">
                <diff:DiffTemplateSelector.SplitTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Grid MinHeight="22" MinWidth="{x:Bind MinWidth}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border>
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind LeftGutter}" />
                                </Border.Background>
                                <TextBlock Text="{x:Bind LeftNumber}" Style="{StaticResource LineNumberStyle}" />
                            </Border>
                            <Border Grid.Column="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind LeftBackground}" />
                                </Border.Background>
                                <TextBlock diff:CodeText.Line="{x:Bind Left}"
                                           TextWrapping="{x:Bind Wrapping}"
                                           Style="{StaticResource CodeStyle}" />
                            </Border>
                            <Rectangle Grid.Column="2" Fill="{ThemeResource SeamBrush}" />
                            <Border Grid.Column="3">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind RightGutter}" />
                                </Border.Background>
                                <TextBlock Text="{x:Bind RightNumber}" Style="{StaticResource LineNumberStyle}" />
                            </Border>
                            <Border Grid.Column="4">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind RightBackground}" />
                                </Border.Background>
                                <TextBlock diff:CodeText.Line="{x:Bind Right}"
                                           TextWrapping="{x:Bind Wrapping}"
                                           Style="{StaticResource CodeStyle}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </diff:DiffTemplateSelector.SplitTemplate>
                <diff:DiffTemplateSelector.UnifiedTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Grid MinHeight="22" MinWidth="{x:Bind MinWidth}">
                            <Grid.Background>
                                <SolidColorBrush Color="{x:Bind LeftBackground}" />
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind LeftGutter}" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{x:Bind LeftNumber}" Style="{StaticResource LineNumberStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind RightNumber}"
                                       Style="{StaticResource LineNumberStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Sign}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,3,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{x:Bind SignColor}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Grid.Column="3"
                                       diff:CodeText.Line="{x:Bind Left}"
                                       Style="{StaticResource CodeStyle}"
                                       TextWrapping="{x:Bind Wrapping}"
                                       Padding="0,2,8,2" />
                        </Grid>
                    </DataTemplate>
                </diff:DiffTemplateSelector.UnifiedTemplate>
                <diff:DiffTemplateSelector.HunkTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Grid Height="32"
                              Background="{ThemeResource HunkHeaderBrush}"
                              BorderBrush="{ThemeResource DividerBrush}"
                              BorderThickness="0,1"
                              ColumnSpacing="6"
                              Padding="14,0,8,0"
                              ToolTipService.ToolTip="{x:Bind Text}">
                            <!--  Buttons sit right after the range, not at the far right: a wide diff scrolls sideways and would hide them.  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       MaxWidth="520"
                                       Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind HunkRange}"
                                     FontSize="12.5"
                                     FontWeight="SemiBold"
                                     Foreground="{ThemeResource HunkRangeBrush}" />
                                <Run Text="   " />
                                <Run Text="{x:Bind HunkSection}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextMutedBrush}" />
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="24"
                                    Padding="10,0"
                                    FontSize="12"
                                    Visibility="{x:Bind CanDiscardHunk}"
                                    Tag="{x:Bind HunkIndex}"
                                    Click="OnDiscardHunk"
                                    AutomationProperties.Name="Discard hunk"
                                    ToolTipService.ToolTip="Throw these lines away (asks first)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7A7;"
                                              FontSize="11"
                                              Foreground="{ThemeResource RedTextBrush}" />
                                    <TextBlock Text="Discard" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="24"
                                    Padding="10,0"
                                    FontSize="12"
                                    Background="{ThemeResource RaisedBrush}"
                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                    Visibility="{x:Bind HasHunkAction}"
                                    Tag="{x:Bind HunkIndex}"
                                    Click="OnHunkAction"
                                    Content="{x:Bind HunkActionLabel}"
                                    AutomationProperties.Name="{x:Bind HunkActionLabel}" />
                        </Grid>
                    </DataTemplate>
                </diff:DiffTemplateSelector.HunkTemplate>
                <diff:DiffTemplateSelector.GapTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Border Height="24" Background="{ThemeResource FillerBrush}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        Margin="14,0">
                                <FontIcon Glyph="&#xE712;"
                                          FontSize="11"
                                          Foreground="{ThemeResource TextMutedBrush}" />
                                <TextBlock Text="{x:Bind Text}"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           FontStyle="Italic" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </diff:DiffTemplateSelector.GapTemplate>
            </diff:DiffTemplateSelector>
            <!--  Interactive rebase planner: one commit, its action, and the new message when reworded.  -->
            <DataTemplate x:Key="RebaseStepTemplate" x:DataType="vm:RebaseStepViewModel">
                <Grid Padding="0,4"
                      ColumnSpacing="10"
                      Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" CornerRadius="2">
                        <Border.Background>
                            <SolidColorBrush Color="{x:Bind AccentColor, Mode=OneWay}" />
                        </Border.Background>
                    </Border>
                    <FontIcon Grid.Column="1"
                              Glyph="&#xE76F;"
                              FontSize="12"
                              Foreground="{ThemeResource TextFaintBrush}"
                              ToolTipService.ToolTip="Drag to reorder" />
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ShortHash}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="{ThemeResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind Subject}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="4"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind vm:RebaseStepViewModel.ActionNames}"
                              SelectedIndex="{x:Bind ActionIndex, Mode=TwoWay}"
                              AutomationProperties.Name="What happens to this commit" />
                    <TextBox Grid.Row="1"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Margin="0,6,0,2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             Visibility="{x:Bind IsReword, Mode=OneWay}"
                             Text="{x:Bind Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="New commit message"
                             AutomationProperties.Name="New commit message" />
                </Grid>
            </DataTemplate>
            <!--  A changed file: status letter, name, folder, +/− counts.  -->
            <DataTemplate x:Key="ChangedFileTemplate" x:DataType="vm:ChangedFileViewModel">
                <Grid Padding="10,0"
                      ColumnSpacing="8"
                      ToolTipService.ToolTip="{x:Bind Model.Path}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Letter}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{x:Bind LetterColor}" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12.5">
                        <Run Text="{x:Bind FileName}" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <Run Text="{x:Bind Directory}"
                             Foreground="{ThemeResource TextMutedBrush}"
                             FontSize="11.5" />
                    </TextBlock>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind AddedText}"
                               FontSize="11.5"
                               Foreground="{ThemeResource GreenTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind DeletedText}"
                               FontSize="11.5"
                               Foreground="{ThemeResource RedTextBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <!--  Compare: one commit on either side; click to see it in History.  -->
            <DataTemplate x:Key="CompareCommitTemplate" x:DataType="vm:CompareCommitRowViewModel">
                <Button Style="{StaticResource GhostButtonStyle}"
                        Height="Auto"
                        Padding="8,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="OnCompareCommitClick"
                        Tag="{x:Bind Commit.Hash}"
                        ToolTipService.ToolTip="Show in History">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{x:Bind MarkerColor}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Subject}"
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind ShortHash}" FontFamily="{StaticResource MonoFont}" />
                                <Run Text="  " />
                                <Run Text="{x:Bind Author}" />
                                <Run Text="  ·  " />
                                <Run Text="{x:Bind WhenText}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="WorkingFileTemplate" x:DataType="vm:WorkingFileViewModel">
                <Grid Padding="10,0,4,0"
                      ColumnSpacing="10"
                      ToolTipService.ToolTip="{x:Bind Path}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="18"
                            Height="18"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind KindText}">
                        <Border.Background>
                            <SolidColorBrush Color="{x:Bind LetterBackground}" />
                        </Border.Background>
                        <TextBlock Text="{x:Bind Letter}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{x:Bind LetterColor}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind FileName}"
                             FontSize="13"
                             Foreground="{ThemeResource TextPrimaryBrush}" />
                        <Run Text="  " />
                        <Run Text="{x:Bind Directory}"
                             FontSize="11.5"
                             Foreground="{ThemeResource TextMutedBrush}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               FontFamily="{StaticResource MonoFont}">
                        <Run Text="{x:Bind AddedText, Mode=OneWay}" Foreground="{ThemeResource GreenTextBrush}" />
                        <Run Text=" " />
                        <Run Text="{x:Bind DeletedText, Mode=OneWay}" Foreground="{ThemeResource RedTextBrush}" />
                    </TextBlock>
                    <Button Grid.Column="3"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="24"
                            Width="28"
                            Padding="0"
                            Tag="{x:Bind}"
                            Click="OnToggleWorkingFile"
                            ToolTipService.ToolTip="{x:Bind ToggleTip}"
                            AutomationProperties.Name="{x:Bind ToggleTip}">
                        <FontIcon Glyph="{x:Bind ToggleGlyph}" FontSize="12" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!--  ═══ Title bar ═══  -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{ThemeResource DeepBrush}"
              BorderBrush="{ThemeResource SeamBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Padding="12,0,0,0">
                <!--  App mark: Assets/AppIcon.svg geometry, cropped to the mark (holes use the title bar color)  -->
                <Viewbox Width="24"
                         Height="24"
                         Margin="0,0,8,0"
                         AutomationProperties.Name="CentralGit">
                    <Canvas Width="320" Height="320">
                        <Canvas.RenderTransform>
                            <TranslateTransform X="-85" Y="-96" />
                        </Canvas.RenderTransform>
                        <Path Data="M354,158 C329,133 298,120 260,120 C185,120 126,180 126,256 C126,332 185,392 260,392 C298,392 329,379 354,354"
                              Stroke="#FF9B83C9"
                              StrokeThickness="32"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="328"
                                 Canvas.Top="132"
                                 Width="52"
                                 Height="52"
                                 Fill="#FF9B83C9" />
                        <Ellipse Canvas.Left="344"
                                 Canvas.Top="148"
                                 Width="20"
                                 Height="20"
                                 Fill="{ThemeResource DeepBrush}" />
                        <Ellipse Canvas.Left="328"
                                 Canvas.Top="328"
                                 Width="52"
                                 Height="52"
                                 Fill="#FF9B83C9" />
                        <Ellipse Canvas.Left="344"
                                 Canvas.Top="344"
                                 Width="20"
                                 Height="20"
                                 Fill="{ThemeResource DeepBrush}" />
                        <Path Data="M236,196 L236,320"
                              Stroke="#FF9B83C9"
                              StrokeThickness="22"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Path Data="M236,284 C236,260 306,260 306,224 L306,206"
                              Stroke="#FFD98A57"
                              StrokeThickness="22"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <Ellipse Canvas.Left="214"
                                 Canvas.Top="174"
                                 Width="44"
                                 Height="44"
                                 Fill="#FF9B83C9" />
                        <Ellipse Canvas.Left="227"
                                 Canvas.Top="187"
                                 Width="18"
                                 Height="18"
                                 Fill="{ThemeResource DeepBrush}" />
                        <Ellipse Canvas.Left="283"
                                 Canvas.Top="183"
                                 Width="46"
                                 Height="46"
                                 Fill="#FFD98A57" />
                        <Ellipse Canvas.Left="296"
                                 Canvas.Top="196"
                                 Width="20"
                                 Height="20"
                                 Fill="{ThemeResource DeepBrush}" />
                        <Ellipse Canvas.Left="210"
                                 Canvas.Top="294"
                                 Width="52"
                                 Height="52"
                                 Fill="#FFCDBEEB" />
                        <Ellipse Canvas.Left="225"
                                 Canvas.Top="309"
                                 Width="22"
                                 Height="22"
                                 Fill="{ThemeResource DeepBrush}" />
                    </Canvas>
                </Viewbox>
                <Button x:Name="RepoButton"
                        Style="{StaticResource GhostButtonStyle}"
                        Background="{ThemeResource SurfaceBrush}"
                        Click="OnOpenSwitcher"
                        ToolTipService.ToolTip="Switch repository (Ctrl+P)"
                        AutomationProperties.Name="Switch repository">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontSize="13" />
                        <FontIcon Glyph="&#xE70D;"
                                  FontSize="10"
                                  Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="/"
                           Foreground="{ThemeResource TextFaintBrush}"
                           VerticalAlignment="Center"
                           Margin="2,0" />
                <Button x:Name="BranchButton"
                        Style="{StaticResource GhostButtonStyle}"
                        AutomationProperties.Name="Switch branch"
                        ToolTipService.ToolTip="Switch or create a branch (Ctrl+B)">
                    <Button.Flyout>
                        <Flyout x:Name="BranchFlyout"
                                Placement="BottomEdgeAlignedLeft"
                                Opening="OnBranchFlyoutOpening"
                                Opened="OnBranchFlyoutOpened">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource SeamBrush}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="MaxWidth" Value="560" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Width="460">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="BranchQuery"
                                         Margin="10,10,10,6"
                                         CornerRadius="6"
                                         FontSize="13"
                                         Text="{x:Bind BranchPicker.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Switch to a branch, or type a new name…"
                                         KeyDown="OnBranchQueryKeyDown"
                                         AutomationProperties.Name="Branch name" />
                                <ListView x:Name="BranchResults"
                                          Grid.Row="1"
                                          MaxHeight="420"
                                          Padding="6,0,6,4"
                                          ItemsSource="{x:Bind BranchPicker.Results, Mode=OneWay}"
                                          SelectedItem="{x:Bind BranchPicker.Selected, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="OnBranchResultClick"
                                          ItemContainerStyle="{StaticResource SwitcherItemStyle}"
                                          AutomationProperties.Name="Branches">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BranchPickItemViewModel">
                                            <Grid Padding="8,0"
                                                  ColumnSpacing="10"
                                                  AutomationProperties.Name="{x:Bind Name}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontSize="13"
                                                          VerticalAlignment="Center">
                                                    <FontIcon.Foreground>
                                                        <SolidColorBrush Color="{x:Bind GlyphColor}" />
                                                    </FontIcon.Foreground>
                                                </FontIcon>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{x:Bind NameColor}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <TextBlock Text="{x:Bind Detail}"
                                                               FontSize="11.5"
                                                               Foreground="{ThemeResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Badge}"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{x:Bind BadgeColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind BranchPicker.Hint, Mode=OneWay}"
                                           Margin="14,4,14,10"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE9D5;"
                                  FontSize="13"
                                  Foreground="{ThemeResource VioletBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BranchName, Mode=OneWay}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontSize="12.5"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.BranchName, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <!--  Its own button so a click opens Changes instead of the branch picker.  -->
                <Button x:Name="ChangesBadge"
                        Style="{StaticResource GhostButtonStyle}"
                        Background="{ThemeResource OrangeTintBrush}"
                        Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}"
                        Height="22"
                        Padding="6,0"
                        CornerRadius="4"
                        Click="OnShowChanges"
                        ToolTipService.ToolTip="Open Changes (Ctrl+2)"
                        AutomationProperties.Name="Open Changes">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{ThemeResource OrangeBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ChangedFilesText, Mode=OneWay}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource OrangeTextBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="CommandBox"
                    Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Background="{ThemeResource SurfaceBrush}"
                    VerticalAlignment="Center"
                    Height="32"
                    CornerRadius="6"
                    MaxWidth="460"
                    Margin="16,0"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Click="OnOpenPalette"
                    AutomationProperties.Name="Command palette">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;"
                              FontSize="12"
                              Foreground="{ThemeResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="Search commits, branches, tags, or run a command"
                               FontSize="12.5"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="Ctrl+K"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextFaintBrush}" />
                </Grid>
            </Button>

            <StackPanel x:Name="SyncPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Margin="0,0,8,0">
                <Button Style="{StaticResource GhostButtonStyle}"
                        AutomationProperties.Name="Open repository in"
                        ToolTipService.ToolTip="Open the repository in Explorer, a terminal or your editor">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Show in Explorer" Click="OnOpenExplorer">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE838;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open terminal here" Click="OnOpenTerminal">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE756;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open in editor" Click="OnOpenEditor">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE943;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{x:Bind ViewModel.FetchCommand}"
                        ToolTipService.ToolTip="git fetch --all --prune">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Fetch" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{x:Bind ViewModel.PullCommand}"
                        AutomationProperties.Name="Pull"
                        ToolTipService.ToolTip="Pull — fast-forward only unless you configured pull.rebase / pull.ff. If the branches diverged you choose rebase or merge.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74B;" FontSize="13" />
                        <TextBlock Text="Pull" />
                        <Border Visibility="{x:Bind ViewModel.HasBehind, Mode=OneWay}"
                                Background="{ThemeResource OrangeTintBrush}"
                                CornerRadius="4"
                                Padding="5,0">
                            <TextBlock Text="{x:Bind ViewModel.BehindCountText, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource OrangeTextBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{x:Bind ViewModel.PushCommand}"
                        AutomationProperties.Name="Push"
                        Background="{ThemeResource VioletTintBrush}"
                        ToolTipService.ToolTip="Push the current branch (publishes it with -u if it has no upstream)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74A;"
                                  FontSize="13"
                                  Foreground="{ThemeResource VioletTextBrush}" />
                        <TextBlock Text="Push" Foreground="{ThemeResource VioletTextBrush}" />
                        <Border Visibility="{x:Bind ViewModel.HasAhead, Mode=OneWay}"
                                Background="{ThemeResource VioletBrush}"
                                CornerRadius="4"
                                Padding="5,0">
                            <TextBlock Text="{x:Bind ViewModel.AheadText, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource DeepBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  ═══ Body ═══  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <Grid x:Name="Sidebar"
                  Background="{ThemeResource WindowBrush}"
                  BorderBrush="{ThemeResource SeamBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="8,10,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="1">
                    <Button x:Name="NavHistory"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowHistory"
                            AutomationProperties.Name="History"
                            ToolTipService.ToolTip="History (Ctrl+1)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="NavHistoryIcon"
                                      Glyph="&#xE81C;"
                                      FontSize="15" />
                            <TextBlock x:Name="NavHistoryText" Text="History" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavChanges"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowChanges"
                            AutomationProperties.Name="Changes"
                            ToolTipService.ToolTip="Changes and commit (Ctrl+2)">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="NavChangesIcon"
                                          Glyph="&#xE8A5;"
                                          FontSize="15" />
                                <TextBlock x:Name="NavChangesText" Text="Changes" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{x:Bind ViewModel.ChangedFilesText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource OrangeTextBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavHealth"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowHealth"
                            AutomationProperties.Name="Health"
                            ToolTipService.ToolTip="Repository health and branch cleanup (Ctrl+3)">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="NavHealthIcon"
                                          Glyph="&#xE95E;"
                                          FontSize="15" />
                                <TextBlock x:Name="NavHealthText" Text="Health" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{x:Bind ViewModel.StaleBranchText, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       ToolTipService.ToolTip="Local branches that could be cleaned up" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavCompare"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowCompare"
                            AutomationProperties.Name="Compare"
                            ToolTipService.ToolTip="Two branches side by side: commits and changed files (Ctrl+4)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="NavCompareIcon"
                                      Glyph="&#xE8AB;"
                                      FontSize="15" />
                            <TextBlock x:Name="NavCompareText" Text="Compare" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavFileHistory"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowFileHistory"
                            AutomationProperties.Name="File History"
                            ToolTipService.ToolTip="Every commit that changed a file, across renames (Ctrl+5)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="NavFileHistoryIcon"
                                      Glyph="&#xE7C3;"
                                      FontSize="15" />
                            <TextBlock x:Name="NavFileHistoryText" Text="File History" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRecovery"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowRecovery"
                            AutomationProperties.Name="Recovery"
                            ToolTipService.ToolTip="Find and restore lost commits from the reflog (Ctrl+6)">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="NavRecoveryIcon"
                                          Glyph="&#xE7A7;"
                                          FontSize="15" />
                                <TextBlock x:Name="NavRecoveryText" Text="Recovery" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{x:Bind ViewModel.RecoverySidebarText, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource OrangeTextBrush}"
                                       ToolTipService.ToolTip="Commits that are no longer on any branch" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavStashes"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OnShowStashes"
                            AutomationProperties.Name="Stash"
                            ToolTipService.ToolTip="Changes you parked to work on later (Ctrl+7)">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="NavStashesIcon"
                                          Glyph="&#xE7B8;"
                                          FontSize="15" />
                                <TextBlock x:Name="NavStashesText" Text="Stash" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{x:Bind ViewModel.Stashes.SidebarText, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       ToolTipService.ToolTip="Stashed changes" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!--  Three tiers: navigation, then the branch tree below a divider, then the repository footer.  -->
                <Border Grid.Row="1"
                        Height="1"
                        Margin="4,10,4,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource DividerBrush}" />
                <TextBlock Grid.Row="1"
                           Text="BRANCHES"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="10,22,0,6" />

                <ListView x:Name="BranchList"
                          Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Branches}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnBranchRowClick"
                          ItemContainerStyle="{StaticResource BranchItemStyle}"
                          AutomationProperties.Name="Branches">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BranchItemViewModel">
                            <Grid Height="28"
                                  CornerRadius="6"
                                  ToolTipService.ToolTip="{x:Bind Tooltip}"
                                  AutomationProperties.Name="{x:Bind FullName}">
                                <Grid.Background>
                                    <SolidColorBrush Color="{x:Bind RowBackground}" />
                                </Grid.Background>

                                <!--  Folder: chevron, name, count  -->
                                <Grid Visibility="{x:Bind IsFolder}"
                                      Padding="{x:Bind Indent}"
                                      ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Chevron}"
                                              FontSize="9"
                                              Width="10"
                                              Foreground="{ThemeResource TextMutedBrush}"
                                              VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1"
                                              Glyph="&#xE8B7;"
                                              FontSize="13"
                                              Foreground="{ThemeResource TextMutedBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Name}"
                                               FontSize="12.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind NameColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Badge}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!--  Branch: dot, name, ahead/behind; right-click menu  -->
                                <Grid Visibility="{x:Bind IsBranch}"
                                      Padding="{x:Bind Indent}"
                                      ColumnSpacing="9"
                                      Background="Transparent"
                                      DoubleTapped="OnBranchDoubleTapped">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Show in History"
                                                            Click="OnBranchReveal"
                                                            Tag="{x:Bind FullName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE81C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Compare"
                                                            Click="OnBranchCompare"
                                                            Tag="{x:Bind FullName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AB;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Switch to this branch"
                                                            Click="OnBranchSwitch"
                                                            Tag="{x:Bind FullName}"
                                                            IsEnabled="{x:Bind IsNotHead}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AB;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="New branch from here…"
                                                            Click="OnBranchNewFrom"
                                                            Tag="{x:Bind FullName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Merge into current branch"
                                                            Click="OnBranchMerge"
                                                            Tag="{x:Bind FullName}"
                                                            IsEnabled="{x:Bind IsNotHead}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEA3C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Rebase current branch onto this…"
                                                            Click="OnBranchRebase"
                                                            Tag="{x:Bind FullName}"
                                                            IsEnabled="{x:Bind IsNotHead}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8EE;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Rename…"
                                                            Click="OnBranchRename"
                                                            Tag="{x:Bind FullName}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete"
                                                            Click="OnBranchDelete"
                                                            Tag="{x:Bind FullName}"
                                                            IsEnabled="{x:Bind IsNotHead}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind DotColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind NameColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind AgeText}"
                                               Visibility="{x:Bind HasAge}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind AgeColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Badge}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind BadgeColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Tags: collapsed by default, a short list when open  -->
                <StackPanel Grid.Row="3"
                            Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay}"
                            Margin="0,6,0,0">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Height="26"
                            Padding="10,0"
                            Click="OnToggleTags"
                            AutomationProperties.Name="Tags"
                            ToolTipService.ToolTip="Show or hide tags">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="TagsChevron"
                                      Glyph="&#xE76C;"
                                      FontSize="9"
                                      Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.TagsHeader, Mode=OneWay}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <ListView x:Name="TagList"
                              MaxHeight="168"
                              Visibility="Collapsed"
                              ItemsSource="{x:Bind ViewModel.Tags}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnTagClick"
                              ItemContainerStyle="{StaticResource BranchItemStyle}"
                              AutomationProperties.Name="Tags">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagItemViewModel">
                                <Grid Padding="12,0,8,0"
                                      ColumnSpacing="8"
                                      Background="Transparent"
                                      ToolTipService.ToolTip="{x:Bind Tooltip}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Show in History"
                                                            Click="OnTagReveal"
                                                            Tag="{x:Bind Name}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE81C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Push to remote"
                                                            Click="OnTagPush"
                                                            Tag="{x:Bind Name}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE898;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete…"
                                                            Click="OnTagDelete"
                                                            Tag="{x:Bind Name}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8EC;"
                                              FontSize="11"
                                              Foreground="{ThemeResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               FontSize="12.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind AgeText}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <Grid Grid.Row="4"
                      Margin="-8,8,-8,-8"
                      Padding="8"
                      Background="{ThemeResource DeepBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,1,0,0"
                      ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Height="Auto"
                            Padding="10,9"
                            Background="{ThemeResource SurfaceBrush}"
                            CornerRadius="8"
                            Click="OnOpenSwitcher"
                            ToolTipService.ToolTip="Switch repository (Ctrl+P)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xF0E2;" FontSize="15" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Repository Hub"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.RepositoryHubText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Background="{ThemeResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="11,0"
                            VerticalAlignment="Stretch"
                            Click="OnOpenSettings"
                            ToolTipService.ToolTip="Settings (Ctrl+,)"
                            AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </Grid>
            </Grid>

            <!--  Workspace: history above, inspector below; the split moves with the mode  -->
            <!--
                Workspace: toolbar over the commit table (Surface), a Window-toned groove, then the
                inspector docked below as a Panel one step up. The groove is the resize handle.
            -->
            <Grid x:Name="Workspace"
                  Grid.Column="1"
                  Background="{ThemeResource WindowBrush}"
                  Visibility="{x:Bind ViewModel.ShowHistory, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HistoryRow" Height="420" />
                    <RowDefinition x:Name="SplitterRow" Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  History  -->
                <Grid x:Name="HistoryPane"
                      Background="{ThemeResource SurfaceBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Style="{StaticResource ToolbarStyle}" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Padding="16,0,12,0">
                        <TextBlock Text="History"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="FilterBox"
                                 Width="300"
                                 Height="28"
                                 CornerRadius="6"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnFilterKeyDown"
                                 ToolTipService.ToolTip="Text matches message, author, hash or ref · author:name · path:src/file.cs (or any path with a slash)"
                                 PlaceholderText="Filter by message, hash, author or path   (Ctrl+F)"
                                 AutomationProperties.Name="Filter commits" />
                        <TextBlock Text="{x:Bind ViewModel.CommitCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />

                        <!--  Sync banner: incoming (orange, pull) · only on this PC (violet, push) · in sync (green)  -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{x:Bind ViewModel.PullCommand}"
                                Visibility="{x:Bind ViewModel.HasIncomingBanner, Mode=OneWay}"
                                Background="{ThemeResource OrangeTintBrush}"
                                CornerRadius="12"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="These commits were fetched from the remote (marked orange below) but aren't in your branch yet. Click to pull them in."
                                AutomationProperties.Name="Pull incoming commits">
                            <TextBlock Text="{x:Bind ViewModel.IncomingBannerText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource OrangeTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{x:Bind ViewModel.PushCommand}"
                                Visibility="{x:Bind ViewModel.HasOutgoingBanner, Mode=OneWay}"
                                Background="{ThemeResource VioletTintBrush}"
                                CornerRadius="12"
                                Padding="10,3"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Your commits (marked violet below) that the remote doesn't have yet. Click to push them."
                                AutomationProperties.Name="Push outgoing commits">
                            <TextBlock Text="{x:Bind ViewModel.OutgoingBannerText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource VioletTextBrush}" />
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.SyncBannerText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasSyncBanner, Mode=OneWay}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{x:Bind ViewModel.SyncBannerColor, Mode=OneWay}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>


                    <!--  Bisect: what to test next, or the commit it found  -->
                    <Grid Grid.Row="1"
                          Padding="16,8,12,8"
                          ColumnSpacing="8"
                          Background="{ThemeResource VioletTintBrush}"
                          BorderBrush="{ThemeResource SeamBrush}"
                          BorderThickness="0,0,0,1"
                          Visibility="{x:Bind ViewModel.HasBisect, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D2;"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource VioletTextBrush}" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{x:Bind ViewModel.BisectTitle, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BisectDetail, Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.IsBisectTesting, Mode=OneWay}">
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,4"
                                        Tag="Good"
                                        Click="OnBisectMarkTested"
                                        ToolTipService.ToolTip="This commit doesn't have the problem">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource GreenTextBrush}" />
                                        <TextBlock Text="Good" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,4"
                                        Tag="Bad"
                                        Click="OnBisectMarkTested"
                                        ToolTipService.ToolTip="This commit has the problem">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource RedTextBrush}" />
                                        <TextBlock Text="Bad" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,4"
                                        Tag="Skip"
                                        Click="OnBisectMarkTested"
                                        Content="Can't test"
                                        ToolTipService.ToolTip="Skip this commit (it doesn't build, say); git picks a neighbour" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,4"
                                    Visibility="{x:Bind ViewModel.IsBisectFound, Mode=OneWay}"
                                    Click="OnBisectShowCulprit"
                                    Content="Show commit" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,4"
                                    Background="{ThemeResource RaisedBrush}"
                                    Click="OnBisectEnd"
                                    Content="End bisect"
                                    ToolTipService.ToolTip="git bisect reset: back to the branch you started from" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2"
                          Padding="8,0,16,0"
                          Style="{StaticResource BandStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Graph"
                                   Margin="6,0,0,0"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Description"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="Author"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="Date"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4"
                                   Text="Commit"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ListView x:Name="HistoryList"
                              Grid.Row="3"
                              ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCommit, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource CommitItemStyle}"
                              AutomationProperties.Name="Commit history"
                              DoubleTapped="OnHistoryDoubleTapped"
                              ContextRequested="OnHistoryContextRequested"
                              PreviewKeyDown="OnHistoryPreviewKeyDown">
                        <!--  One menu for every row: right-click selects the row first, then this acts on the selection.  -->
                        <ListView.ContextFlyout>
                            <MenuFlyout x:Name="CommitMenu" Opening="OnCommitMenuOpening">
                                <MenuFlyoutItem Text="Copy hash" Click="OnCommitCopyHash">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy message" Click="OnCommitCopyMessage">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="New branch here…" Click="OnCommitNewBranch">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Tag…" Click="OnCommitTag">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8EC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="CommitCherryPickItem"
                                                Text="Cherry-pick onto current branch"
                                                Click="OnCommitCherryPick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CommitRevertItem"
                                                Text="Revert…"
                                                Click="OnCommitRevert">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CommitResetItem"
                                                Text="Reset current branch to here…"
                                                Click="OnCommitReset">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CommitEditItem"
                                                Text="Edit commits from here…"
                                                Click="OnCommitEditFromHere">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem Text="Bisect">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE9D2;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Text="Mark bad (has the problem)"
                                                    Tag="Bad"
                                                    Click="OnBisectMarkCommit" />
                                    <MenuFlyoutItem Text="Mark good (from before the problem)"
                                                    Tag="Good"
                                                    Click="OnBisectMarkCommit" />
                                    <MenuFlyoutItem Text="Skip (can't test this one)"
                                                    Tag="Skip"
                                                    Click="OnBisectMarkCommit" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem x:Name="CommitUndoItem"
                                                Text="Undo this commit (keep changes)…"
                                                Click="OnUndoLastCommit">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommitRowViewModel">
                                <Grid Height="26" Padding="8,0,16,0">
                                    <Grid.Background>
                                        <SolidColorBrush Color="{x:Bind RowTint}" />
                                    </Grid.Background>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="3"
                                               HorizontalAlignment="Left"
                                               Margin="-8,2,0,2"
                                               RadiusX="1.5"
                                               RadiusY="1.5">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{x:Bind EdgeColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <graph:GraphCell Row="{x:Bind}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Padding="0,0,16,0">
                                        <ItemsControl ItemsSource="{x:Bind Refs}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RefChipViewModel">
                                                    <Border Height="18"
                                                            Padding="6,0"
                                                            CornerRadius="4"
                                                            BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{x:Bind Background}" />
                                                        </Border.Background>
                                                        <Border.BorderBrush>
                                                            <SolidColorBrush Color="{x:Bind Border}" />
                                                        </Border.BorderBrush>
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   FontSize="11.5"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{x:Bind Foreground}" />
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Height="18"
                                                Padding="7,0"
                                                CornerRadius="9"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasSync}"
                                                ToolTipService.ToolTip="{x:Bind SyncTooltip}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind SyncBackground}" />
                                            </Border.Background>
                                            <TextBlock Text="{x:Bind SyncText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind SyncForeground}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{x:Bind Subject}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind SubjectColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Author}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Date}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind ShortHash}"
                                               FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <controls:Splitter x:Name="HistorySplitter"
                                   Grid.Row="1"
                                   ShowLine="False"
                                   ShowGrip="True"
                                   ToolTipService.ToolTip="Drag to resize · double-click to reset" />

                <!--  Inspector: a docked panel, lit along its top edge  -->
                <Grid x:Name="InspectorPane"
                      Grid.Row="2"
                      Background="{ThemeResource PanelBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DetailsColumn" Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2"
                            Height="1"
                            VerticalAlignment="Top"
                            Background="{ThemeResource HighlightBrush}"
                            Canvas.ZIndex="1"
                            IsHitTestVisible="False" />

                    <TextBlock Grid.ColumnSpan="2"
                               Text="{x:Bind ViewModel.Inspector.EmptyText, Mode=OneWay}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="600"
                               Visibility="{x:Bind ViewModel.Inspector.HasNoDetails, Mode=OneWay}" />

                    <!--  Details  -->
                    <Grid x:Name="DetailsPane"
                          BorderBrush="{ThemeResource SeamBrush}"
                          BorderThickness="0,0,1,0"
                          Visibility="{x:Bind ViewModel.Inspector.HasDetails, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16,14,16,12" Spacing="10">
                                <!--  The violet edge echoes the selected row's indicator: this is that commit.  -->
                                <Grid>
                                    <Border Width="3"
                                            Margin="-10,2,0,2"
                                            HorizontalAlignment="Left"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource VioletBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Inspector.Details.Subject, Mode=OneWay}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.Inspector.Details.Body, Mode=OneWay}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.Inspector.Details.HasBody, Mode=OneWay}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Background="{ThemeResource ElevatedBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.Inspector.Details.AuthorInitials, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                        <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind ViewModel.Inspector.Details.AuthorName, Mode=OneWay}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <Run Text="{x:Bind ViewModel.Inspector.Details.AuthorEmail, Mode=OneWay}" Foreground="{ThemeResource TextMutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind ViewModel.Inspector.Details.AuthorDate, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.Inspector.Details.CommitterLine, Mode=OneWay}"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           Visibility="{x:Bind ViewModel.Inspector.Details.HasCommitter, Mode=OneWay}"
                                           TextWrapping="Wrap" />

                                <Grid RowSpacing="6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Commit"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.Inspector.Details.ShortHash, Mode=OneWay}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   IsTextSelectionEnabled="True" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Padding="6,2"
                                                Click="OnCopyHash"
                                                ToolTipService.ToolTip="Copy full hash"
                                                AutomationProperties.Name="Copy full hash">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind ViewModel.Inspector.Details.ParentsLabel, Mode=OneWay}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ItemsControl Grid.Row="1"
                                                  Grid.Column="1"
                                                  ItemsSource="{x:Bind ViewModel.Inspector.Details.Parents, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ParentViewModel">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Padding="6,2"
                                                        Tag="{x:Bind Hash}"
                                                        Click="OnParentClick"
                                                        Background="{ThemeResource RaisedBrush}"
                                                        ToolTipService.ToolTip="Go to parent">
                                                    <TextBlock Text="{x:Bind ShortHash}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="12" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="2"
                                               Text="Signature"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Inspector.Details.SignatureText, Mode=OneWay}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind ViewModel.Inspector.Details.SignatureColor, Mode=OneWay}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,8,0,0"
                                            Visibility="{x:Bind ViewModel.HasSelectedChecks, Mode=OneWay}"
                                            ToolTipService.ToolTip="CI check runs on GitHub for this commit">
                                    <Ellipse Width="7"
                                             Height="7"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind ViewModel.SelectedChecksColor, Mode=OneWay}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedChecksText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1"
                              Padding="16,6,16,6"
                              Style="{StaticResource BandStyle}"
                              BorderThickness="0,1,0,1"
                              Margin="0,0,0,4"
                              ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Inspector.Details.FilesSummary, Mode=OneWay}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Inspector.Details.AddedText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource GreenTextBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.Inspector.Details.DeletedText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource RedTextBrush}" />
                        </Grid>

                        <ListView x:Name="FileList"
                                  Grid.Row="2"
                                  Padding="0,0,0,8"
                                  ItemsSource="{x:Bind ViewModel.Inspector.Details.Files, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Inspector.SelectedFile, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource FileItemStyle}"
                                  AutomationProperties.Name="Changed files">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChangedFileViewModel">
                                    <Grid Padding="10,0"
                                          ColumnSpacing="8"
                                          ToolTipService.ToolTip="{x:Bind Model.Path}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="File history"
                                                                Click="OnFileHistoryFromInspector"
                                                                Tag="{x:Bind Model.Path}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE81C;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Letter}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind LetterColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12.5">
                                            <Run Text="{x:Bind FileName}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <Run Text="{x:Bind Directory}"
                                                 Foreground="{ThemeResource TextMutedBrush}"
                                                 FontSize="11.5" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind AddedText}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource GreenTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind DeletedText}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource RedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!--  Diff  -->
                    <Grid x:Name="DiffPane"
                          Grid.Column="1"
                          Background="{ThemeResource RecessedBrush}"
                          Visibility="{x:Bind ViewModel.Inspector.HasDetails, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="14,0,8,0"
                              ColumnSpacing="10"
                              Style="{StaticResource ToolbarStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run x:Name="FocusCommitRun"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextMutedBrush}" />
                                <Run Text="{x:Bind ViewModel.Inspector.DiffTitle, Mode=OneWay}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{ThemeResource TextPrimaryBrush}" />
                                <Run Text="{x:Bind ViewModel.Inspector.DiffDirectory, Mode=OneWay}"
                                     FontSize="12"
                                     Foreground="{ThemeResource TextMutedBrush}" />
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Inspector.ChangePosition, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="7,4"
                                        Click="OnPreviousChange"
                                        ToolTipService.ToolTip="Previous change (Alt+Up)"
                                        AutomationProperties.Name="Previous change">
                                    <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="7,4"
                                        Click="OnNextChange"
                                        ToolTipService.ToolTip="Next change (Alt+Down)"
                                        AutomationProperties.Name="Next change">
                                    <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                </Button>
                            </StackPanel>
                            <Border Grid.Column="3"
                                    Background="{ThemeResource DeepBrush}"
                                    CornerRadius="7"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="SplitButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,3"
                                            Click="OnSplitClick"
                                            Content="Split"
                                            FontSize="12" />
                                    <Button x:Name="UnifiedButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,3"
                                            Click="OnUnifiedClick"
                                            Content="Unified"
                                            FontSize="12" />
                                    <Rectangle Width="1"
                                               Margin="2,4"
                                               Fill="{ThemeResource SeamBrush}" />
                                    <Button x:Name="WrapButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="8,3"
                                            Click="OnToggleWrap"
                                            AutomationProperties.Name="Wrap long lines"
                                            ToolTipService.ToolTip="Wrap long lines to the pane, or keep them whole and scroll sideways">
                                        <TextBlock Text="Wrap" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button x:Name="FocusButton"
                                    Grid.Column="4"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,5"
                                    Click="OnFocusClick"
                                    ToolTipService.ToolTip="Focus on the diff (Enter) · Esc to go back"
                                    AutomationProperties.Name="Focus on the diff">
                                <FontIcon x:Name="FocusGlyph"
                                          Glyph="&#xE740;"
                                          FontSize="12" />
                            </Button>
                        </Grid>

                        <ListView x:Name="DiffList"
                                  Style="{StaticResource DiffListStyle}"
                                  Background="{ThemeResource RecessedBrush}"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Inspector.DiffRows, Mode=OneWay}"
                                  ItemTemplateSelector="{StaticResource DiffRowSelector}"
                                  AutomationProperties.Name="Diff" />

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.Inspector.DiffMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.Inspector.HasDiffMessage, Mode=OneWay}" />
                    </Grid>

                    <controls:Splitter x:Name="DetailsSplitter"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       ShowLine="False"
                                       Width="6"
                                       HorizontalAlignment="Left"
                                       Margin="-3,0,0,0"
                                       ToolTipService.ToolTip="Drag to resize · double-click to reset" />
                </Grid>
            </Grid>

            <!--  ═══ Changes: working tree, staging and the commit composer ═══  -->
            <Grid x:Name="ChangesPage"
                  Grid.Column="1"
                  Background="{ThemeResource SurfaceBrush}"
                  Visibility="{x:Bind ViewModel.ShowChanges, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChangesFilesColumn" Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Files + composer  -->
                <Grid Background="{ThemeResource WindowBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,0,10,0">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Uncommitted changes"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.Changes.Subtitle, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,0"
                                    Click="OnStashAll"
                                    Visibility="{x:Bind ViewModel.Changes.HasFiles, Mode=OneWay}"
                                    AutomationProperties.Name="Stash all changes"
                                    ToolTipService.ToolTip="Stash all changes: park them and get a clean working tree">
                                <FontIcon Glyph="&#xE7B8;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,0"
                                    Click="OnUndoLastCommit"
                                    AutomationProperties.Name="Undo last commit"
                                    ToolTipService.ToolTip="Undo the last commit and keep its changes staged">
                                <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,0"
                                    Click="OnRefreshChanges"
                                    AutomationProperties.Name="Refresh changes"
                                    ToolTipService.ToolTip="Refresh (F5) — also happens when you come back to the window">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  A merge, rebase, cherry-pick or revert waiting on the user  -->
                    <Border Grid.Row="1"
                            Margin="10,0,10,8"
                            Padding="12,10,12,12"
                            CornerRadius="8"
                            Background="{ThemeResource OrangeTintBrush}"
                            Visibility="{x:Bind ViewModel.HasInProgress, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="13"
                                          Foreground="{ThemeResource OrangeTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.InProgressTitle, Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource OrangeTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.InProgressDetail, Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,4,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Height="28"
                                        FontSize="12.5"
                                        Click="OnContinueInProgress"
                                        IsEnabled="{x:Bind ViewModel.CanContinue, Mode=OneWay}"
                                        Content="{x:Bind ViewModel.ContinueLabel, Mode=OneWay}" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Height="28"
                                        Background="{ThemeResource RaisedBrush}"
                                        Click="OnAbortInProgress"
                                        Content="{x:Bind ViewModel.AbortLabel, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Visibility="{x:Bind ViewModel.Changes.IsClean, Mode=OneWay}"
                               Text="{x:Bind ViewModel.Changes.CleanText, Mode=OneWay}"
                               Margin="16,8"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextMutedBrush}" />

                    <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.Changes.HasFiles, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition x:Name="UnstagedRow" Height="*" />
                            <RowDefinition Height="34" />
                            <RowDefinition x:Name="StagedRow" Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,0,8,0">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.Changes.UnstagedHeader, Mode=OneWay}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     CharacterSpacing="60"
                                     Foreground="{ThemeResource OrangeTextBrush}" />
                                <Run Text="   " />
                                <Run Text="{x:Bind ViewModel.Changes.UnstagedTotals, Mode=OneWay}"
                                     FontSize="11.5"
                                     FontFamily="{StaticResource MonoFont}"
                                     Foreground="{ThemeResource TextMutedBrush}" />
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="24"
                                    Padding="8,0"
                                    FontSize="12"
                                    Content="Stage all"
                                    Click="OnStageAll"
                                    IsEnabled="{x:Bind ViewModel.Changes.HasUnstaged, Mode=OneWay}"
                                    AutomationProperties.Name="Stage all" />
                        </Grid>
                        <ListView x:Name="UnstagedList"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Changes.Unstaged}"
                                  SelectedItem="{x:Bind ViewModel.Changes.SelectedUnstaged, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource FileItemStyle}"
                                  DoubleTapped="OnWorkingFileDoubleTapped"
                                  KeyDown="OnWorkingFileKeyDown"
                                  AutomationProperties.Name="Unstaged files"
                                  ItemTemplate="{StaticResource WorkingFileTemplate}" />
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.Changes.EmptyUnstagedText, Mode=OneWay}"
                                   Margin="16,6,16,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   IsHitTestVisible="False" />

                        <Grid Grid.Row="2"
                              Padding="16,0,8,0"
                              BorderBrush="{ThemeResource DividerBrush}"
                              BorderThickness="0,1,0,0">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.Changes.StagedHeader, Mode=OneWay}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     CharacterSpacing="60"
                                     Foreground="{ThemeResource GreenTextBrush}" />
                                <Run Text="   " />
                                <Run Text="{x:Bind ViewModel.Changes.StagedTotals, Mode=OneWay}"
                                     FontSize="11.5"
                                     FontFamily="{StaticResource MonoFont}"
                                     Foreground="{ThemeResource TextMutedBrush}" />
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="24"
                                    Padding="8,0"
                                    FontSize="12"
                                    Content="Unstage all"
                                    Click="OnUnstageAll"
                                    IsEnabled="{x:Bind ViewModel.Changes.HasStaged, Mode=OneWay}"
                                    AutomationProperties.Name="Unstage all" />
                        </Grid>
                        <ListView x:Name="StagedList"
                                  Grid.Row="3"
                                  ItemsSource="{x:Bind ViewModel.Changes.Staged}"
                                  SelectedItem="{x:Bind ViewModel.Changes.SelectedStaged, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource FileItemStyle}"
                                  DoubleTapped="OnWorkingFileDoubleTapped"
                                  KeyDown="OnWorkingFileKeyDown"
                                  AutomationProperties.Name="Staged files"
                                  ItemTemplate="{StaticResource WorkingFileTemplate}" />
                        <TextBlock Grid.Row="3"
                                   Text="{x:Bind ViewModel.Changes.EmptyStagedText, Mode=OneWay}"
                                   Margin="16,6,16,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   IsHitTestVisible="False" />
                        <controls:Splitter x:Name="StagedSplitter"
                                           Grid.Row="2"
                                           VerticalAlignment="Top"
                                           Height="6"
                                           Margin="0,-3,0,0"
                                           ShowLine="False"
                                           ToolTipService.ToolTip="Drag to resize · double-click to reset" />
                    </Grid>

                    <!--  Composer  -->
                    <StackPanel Grid.Row="3"
                                Padding="12,12,12,14"
                                Spacing="8"
                                Background="{ThemeResource ToolbarBrush}"
                                BorderBrush="{ThemeResource SeamBrush}"
                                BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBox x:Name="SummaryBox"
                                     Text="{x:Bind ViewModel.Changes.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Summary (required)"
                                     FontSize="13"
                                     Padding="10,7,40,6"
                                     CornerRadius="6"
                                     KeyDown="OnComposerKeyDown"
                                     AutomationProperties.Name="Commit summary" />
                            <TextBlock Text="{x:Bind ViewModel.Changes.SummaryCounter, Mode=OneWay}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       IsHitTestVisible="False"
                                       ToolTipService.ToolTip="Keep the summary under 50 characters; git tools cut it off after 72">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.Changes.SummaryCounterColor, Mode=OneWay}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                        <TextBox Text="{x:Bind ViewModel.Changes.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Description — why this change, not what"
                                 FontSize="12.5"
                                 Padding="10,7"
                                 CornerRadius="6"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="92"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="OnComposerKeyDown"
                                 AutomationProperties.Name="Commit description" />

                        <Border Visibility="{x:Bind ViewModel.Changes.HasError, Mode=OneWay}"
                                Background="{ThemeResource RedTintBrush}"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.Changes.ErrorTitle, Mode=OneWay}"
                                           Foreground="{ThemeResource RedTextBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="110"
                                              HorizontalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind ViewModel.Changes.ErrorDetail, Mode=OneWay}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Amend last commit"
                                      IsChecked="{x:Bind ViewModel.Changes.IsAmend, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.Changes.CanAmend, Mode=OneWay}"
                                      FontSize="12.5"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Amend last commit"
                                      ToolTipService.ToolTip="Rewrite the last commit instead of adding a new one. Avoid this if it was already pushed." />
                            <ProgressRing Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          Width="16"
                                          Height="16"
                                          MinWidth="16"
                                          MinHeight="16"
                                          IsActive="{x:Bind ViewModel.Changes.IsBusy, Mode=OneWay}"
                                          Foreground="{ThemeResource TealBrush}" />
                        </Grid>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnCommit"
                                IsEnabled="{x:Bind ViewModel.Changes.CanCommit, Mode=OneWay}"
                                AutomationProperties.Name="Commit">
                            <TextBlock Text="{x:Bind ViewModel.Changes.CommitButtonText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.Changes.CommitHint, Mode=OneWay}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!--  Diff of the selected working file  -->
                <Grid Grid.Column="1" Background="{ThemeResource RecessedBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,0,8,0"
                          ColumnSpacing="10"
                          Style="{StaticResource ToolbarStyle}"
                          Visibility="{x:Bind ViewModel.Changes.HasSelection, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind ViewModel.Changes.DiffBreadcrumb, Mode=OneWay}"
                                     FontSize="12.5"
                                     Foreground="{ThemeResource TextMutedBrush}" />
                                <Run Text="{x:Bind ViewModel.Changes.DiffTitle, Mode=OneWay}"
                                     FontSize="13.5"
                                     FontWeight="SemiBold"
                                     Foreground="{ThemeResource TextPrimaryBrush}" />
                            </TextBlock>
                            <Border CornerRadius="4"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind ViewModel.Changes.SideBackground, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock Text="{x:Bind ViewModel.Changes.SideText, Mode=OneWay}" FontSize="11.5">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{x:Bind ViewModel.Changes.SideColor, Mode=OneWay}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       FontFamily="{StaticResource MonoFont}">
                                <Run Text="{x:Bind ViewModel.Changes.Selected.AddedText, Mode=OneWay, FallbackValue=''}" Foreground="{ThemeResource GreenTextBrush}" />
                                <Run Text=" " />
                                <Run Text="{x:Bind ViewModel.Changes.Selected.DeletedText, Mode=OneWay, FallbackValue=''}" Foreground="{ThemeResource RedTextBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <!--  Conflicted file: take one side whole  -->
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Background="{ThemeResource RaisedBrush}"
                                    Click="OnTakeOurs"
                                    Visibility="{x:Bind ViewModel.Changes.IsConflictSelected, Mode=OneWay}"
                                    Content="Keep ours"
                                    ToolTipService.ToolTip="Resolve with HEAD's version of the file (during a rebase: the branch you're rebasing onto)" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Background="{ThemeResource RaisedBrush}"
                                    Click="OnTakeTheirs"
                                    Visibility="{x:Bind ViewModel.Changes.IsConflictSelected, Mode=OneWay}"
                                    Content="Take theirs"
                                    ToolTipService.ToolTip="Resolve with the incoming version of the file (during a rebase: your commit being replayed)" />
                            <!--  Lines selected in the diff (Ctrl/Shift+click)  -->
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Click="OnDiscardLines"
                                    Visibility="{x:Bind ViewModel.Changes.CanDiscardLines, Mode=OneWay}"
                                    AutomationProperties.Name="Discard selected lines"
                                    ToolTipService.ToolTip="Throw away only the selected lines (asks first)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7A7;"
                                              FontSize="12"
                                              Foreground="{ThemeResource RedTextBrush}" />
                                    <TextBlock Text="Discard lines" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Background="{ThemeResource VioletTintBrush}"
                                    Foreground="{ThemeResource VioletTextBrush}"
                                    Click="OnApplyLines"
                                    Visibility="{x:Bind ViewModel.Changes.HasLineSelection, Mode=OneWay}"
                                    Content="{x:Bind ViewModel.Changes.LineActionLabel, Mode=OneWay}"
                                    ToolTipService.ToolTip="Only the selected lines; the rest of the change stays where it is" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Click="OnOpenSelectedInEditor"
                                    Visibility="{x:Bind ViewModel.Changes.HasSelectedFile, Mode=OneWay}"
                                    AutomationProperties.Name="Open file in editor"
                                    ToolTipService.ToolTip="Open this file in your editor">
                                <FontIcon Glyph="&#xE943;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Click="OnDiscardFile"
                                    Visibility="{x:Bind ViewModel.Changes.CanDiscardFile, Mode=OneWay}"
                                    AutomationProperties.Name="Discard file"
                                    ToolTipService.ToolTip="Throw away the unstaged changes to this file (asks first)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7A7;"
                                              FontSize="12"
                                              Foreground="{ThemeResource RedTextBrush}" />
                                    <TextBlock Text="Discard" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Background="{ThemeResource RaisedBrush}"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Click="OnToggleSelectedFile"
                                Content="{x:Bind ViewModel.Changes.ToggleFileLabel, Mode=OneWay}"
                                AutomationProperties.Name="Stage or unstage file" />
                        <Border Grid.Column="3"
                                Background="{ThemeResource DeepBrush}"
                                CornerRadius="7"
                                Padding="2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="ChangesSplitButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,3"
                                        Click="OnChangesSplit"
                                        Content="Split"
                                        FontSize="12" />
                                <Button x:Name="ChangesUnifiedButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,3"
                                        Click="OnChangesUnified"
                                        Content="Unified"
                                        FontSize="12" />
                                <Rectangle Width="1"
                                           Margin="2,4"
                                           Fill="{ThemeResource SeamBrush}" />
                                <Button x:Name="ChangesWrapButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,3"
                                        Click="OnToggleWrap"
                                        AutomationProperties.Name="Wrap long lines"
                                        ToolTipService.ToolTip="Wrap long lines to the pane, or keep them whole and scroll sideways">
                                    <TextBlock Text="Wrap" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListView x:Name="ChangesDiffList"
                              Style="{StaticResource DiffListStyle}"
                              Background="{ThemeResource RecessedBrush}"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Changes.DiffRows, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource DiffRowSelector}"
                              SelectionMode="Extended"
                              SelectionChanged="OnChangesDiffSelectionChanged"
                              AutomationProperties.Name="Working diff" />
                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.Changes.DiffMessage, Mode=OneWay}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.Changes.HasDiffMessage, Mode=OneWay}" />

                    <!--  Conflict editor: replaces the diff while a conflicted file is selected.  -->
                    <Grid Grid.Row="1"
                          Background="{ThemeResource RecessedBrush}"
                          Visibility="{x:Bind ViewModel.ConflictEditor.IsActive, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="ConflictList"
                                  ItemsSource="{x:Bind ViewModel.ConflictEditor.Blocks, Mode=OneWay}"
                                  SelectionMode="None"
                                  Padding="16,12"
                                  ItemContainerStyle="{StaticResource DiffItemStyle}"
                                  AutomationProperties.Name="Conflicts">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConflictBlockViewModel">
                                    <Grid Margin="0,0,0,10">
                                        <!--  Unchanged text around the conflicts  -->
                                        <TextBlock Visibility="{x:Bind IsCommon}"
                                                   Text="{x:Bind CommonText}"
                                                   Style="{StaticResource CodeStyle}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   Padding="12,0" />
                                        <!--  One conflict: both sides and the choices  -->
                                        <Border Visibility="{x:Bind IsConflict}"
                                                Style="{StaticResource CardStyle}"
                                                Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Padding="14,8"
                                                      ColumnSpacing="6"
                                                      BorderBrush="{ThemeResource DividerBrush}"
                                                      BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="10"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind ChoiceText, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Padding="10,3"
                                                            FontSize="12"
                                                            Tag="Ours"
                                                            Click="OnConflictChoose"
                                                            Content="Use yours" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Padding="10,3"
                                                            FontSize="12"
                                                            Tag="Theirs"
                                                            Click="OnConflictChoose"
                                                            Content="Use incoming" />
                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Padding="10,3"
                                                            FontSize="12"
                                                            Tag="OursThenTheirs"
                                                            Click="OnConflictChoose"
                                                            Content="Both"
                                                            ToolTipService.ToolTip="Keep both: yours first, then incoming" />
                                                    <Button Grid.Column="5"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Padding="10,3"
                                                            FontSize="12"
                                                            Tag="TheirsThenOurs"
                                                            Click="OnConflictChoose"
                                                            Content="Both, incoming first" />
                                                </Grid>
                                                <Grid Grid.Row="1" ColumnSpacing="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Opacity="{x:Bind OursOpacity, Mode=OneWay}"
                                                                Background="{ThemeResource VioletTintBrush}"
                                                                Padding="0,6,0,10">
                                                        <TextBlock Text="{x:Bind OursLabel}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource VioletTextBrush}"
                                                                   Margin="12,0,12,4" />
                                                        <TextBlock Text="{x:Bind Ours}"
                                                                   Style="{StaticResource CodeStyle}"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"
                                                                   Padding="12,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Opacity="{x:Bind TheirsOpacity, Mode=OneWay}"
                                                                Background="{ThemeResource OrangeTintBrush}"
                                                                Padding="0,6,0,10"
                                                                ToolTipService.ToolTip="{x:Bind BaseTooltip}">
                                                        <TextBlock Text="{x:Bind TheirsLabel}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource OrangeTextBrush}"
                                                                   Margin="12,0,12,4" />
                                                        <TextBlock Text="{x:Bind Theirs}"
                                                                   Style="{StaticResource CodeStyle}"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"
                                                                   Padding="12,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="1"
                              Style="{StaticResource ToolbarStyle}"
                              Padding="16,8"
                              ColumnSpacing="8"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ConflictEditor.ProgressText, Mode=OneWay}"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ConflictEditor.Message, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ConflictEditor.HasMessage, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource RedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,4"
                                    Click="OnConflictAllOurs"
                                    Content="All yours" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,4"
                                    Click="OnConflictAllTheirs"
                                    Content="All incoming" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnConflictSave"
                                    IsEnabled="{x:Bind ViewModel.ConflictEditor.CanSave, Mode=OneWay}"
                                    Content="Save and mark resolved" />
                        </Grid>
                    </Grid>
                </Grid>

                <controls:Splitter x:Name="ChangesFilesSplitter"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   ShowLine="False"
                                   Width="6"
                                   HorizontalAlignment="Left"
                                   Margin="-3,0,0,0"
                                   ToolTipService.ToolTip="Drag to resize · double-click to reset" />
            </Grid>

            <!--  ═══ Health: numbers, branch cleanup, diagnostics ═══  -->
            <ScrollViewer x:Name="HealthPage"
                          Grid.Column="1"
                          Background="{ThemeResource WindowBrush}"
                          Visibility="{x:Bind ViewModel.ShowHealth, Mode=OneWay}"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Padding="28,22,28,28"
                      RowSpacing="16"
                      MaxWidth="1280"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Repository health"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="Stale branches, activity and setup problems at a glance."
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.Health.IsLoading, Mode=OneWay}"
                                          Width="16"
                                          Height="16" />
                            <TextBlock Text="{x:Bind ViewModel.Health.LoadedText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnHealthRefresh"
                                AutomationProperties.Name="Refresh health"
                                ToolTipService.ToolTip="Check again (F5)">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.Health.ErrorText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.Health.HasError, Mode=OneWay}"
                               Foreground="{ThemeResource RedTextBrush}"
                               TextWrapping="Wrap" />

                    <!--  Tiles  -->
                    <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind ViewModel.Health.Tiles}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200"
                                               MinItemHeight="112"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="12"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HealthTileViewModel">
                                <Grid Background="{ThemeResource SurfaceBrush}"
                                      CornerRadius="10"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle RadiusX="1.5" RadiusY="1.5">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{x:Bind Accent}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Value}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="420" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <!--  Branch cleanup  -->
                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock Text="Branch cleanup" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.Health.CleanupSubtitle, Mode=OneWay}" Style="{StaticResource CardHintStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="HealthLocalTab"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OnHealthShowLocal"
                                            Content="{x:Bind ViewModel.Health.LocalTabText, Mode=OneWay}" />
                                    <Button x:Name="HealthRemoteTab"
                                            Grid.Column="1"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OnHealthShowRemote"
                                            Content="{x:Bind ViewModel.Health.RemoteTabText, Mode=OneWay}"
                                            ToolTipService.ToolTip="Remote-tracking branches as of the last fetch. Deleting them removes them from the server for everyone." />
                                    <Button Grid.Column="3"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OnHealthSelectMerged"
                                            Content="Select merged"
                                            ToolTipService.ToolTip="Select every branch whose commits are already in a main branch" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OnHealthSelectNone"
                                            Content="Clear" />
                                    <Button Grid.Column="5"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OnHealthDelete"
                                            IsEnabled="{x:Bind ViewModel.Health.HasSelection, Mode=OneWay}"
                                            AutomationProperties.Name="Delete selected branches">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE74D;"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource RedTextBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.Health.DeleteButtonText, Mode=OneWay}" Foreground="{ThemeResource RedTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Health.Cleanup}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CleanupRowViewModel">
                                            <Grid Height="40"
                                                  ColumnSpacing="10"
                                                  ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                  BorderBrush="{ThemeResource DividerBrush}"
                                                  BorderThickness="0,1,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          MinWidth="0"
                                                          Padding="0"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="{x:Bind SelectLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12.5"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="2"
                                                        CornerRadius="9"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind ReasonBackground}" />
                                                    </Border.Background>
                                                    <TextBlock Text="{x:Bind Reason}" FontSize="11.5">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{x:Bind ReasonColor}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="3"
                                                            Width="170"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind AgeText}"
                                                               FontSize="11.5"
                                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                                               TextAlignment="Right" />
                                                    <TextBlock Text="{x:Bind Author}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextMutedBrush}"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <TextBlock Text="{x:Bind ViewModel.Health.EmptyCleanupText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.Health.HasNoCleanup, Mode=OneWay}"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,4" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="16">
                            <!--  Diagnostics  -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Diagnostics" Style="{StaticResource CardTitleStyle}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Health.Findings}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="12" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HealthFindingViewModel">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph}"
                                                              FontSize="14"
                                                              VerticalAlignment="Top"
                                                              Margin="0,2,0,0">
                                                        <FontIcon.Foreground>
                                                            <SolidColorBrush Color="{x:Bind Color}" />
                                                        </FontIcon.Foreground>
                                                    </FontIcon>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Detail}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>

                            <!--  Setup  -->
                            <Border Style="{StaticResource CardStyle}">
                                <Grid RowSpacing="8" ColumnSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.ColumnSpan="2"
                                               Text="Setup"
                                               Style="{StaticResource CardTitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="1"
                                               Text="Main branch"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Health.TrunkText, Mode=OneWay}"
                                               FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Row="2"
                                               Text="Identity"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Health.IdentityText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Row="3"
                                               Text="Remotes"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Health.RemotesText, Mode=OneWay}"
                                               FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Row="4"
                                               Text="Worktrees"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Health.WorktreesText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="5"
                                               Text="Git"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Health.GitVersionText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               IsTextSelectionEnabled="True" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!--  ═══ Recovery (reflog) ═══  -->
            <ScrollViewer x:Name="RecoveryPage"
                          Grid.Column="1"
                          Background="{ThemeResource WindowBrush}"
                          Visibility="{x:Bind ViewModel.ShowRecovery, Mode=OneWay}"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Padding="28,22,28,28"
                      RowSpacing="16"
                      MaxWidth="1280"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recovery"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="Everything HEAD has pointed at (the reflog). Commits that a reset, rebase, amend or deleted branch left behind can be brought back as a branch."
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.Recovery.IsLoading, Mode=OneWay}"
                                          Width="16"
                                          Height="16" />
                            <TextBlock Text="{x:Bind ViewModel.Recovery.LoadedText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnRecoveryRefresh"
                                AutomationProperties.Name="Refresh recovery"
                                ToolTipService.ToolTip="Read the reflog again (F5)">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.Recovery.ErrorText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.Recovery.HasError, Mode=OneWay}"
                               Foreground="{ThemeResource RedTextBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="RecoveryLostTab"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="OnRecoveryShowLost"
                                        Content="{x:Bind ViewModel.Recovery.LostTabText, Mode=OneWay}"
                                        ToolTipService.ToolTip="Commits no branch, tag or stash holds any more" />
                                <Button x:Name="RecoveryAllTab"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="OnRecoveryShowAll"
                                        Content="{x:Bind ViewModel.Recovery.AllTabText, Mode=OneWay}"
                                        ToolTipService.ToolTip="Every commit HEAD has pointed at, newest first" />
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recovery.Rows}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecoveryRowViewModel">
                                        <Grid Padding="8,8"
                                              ColumnSpacing="12"
                                              CornerRadius="6"
                                              Background="{ThemeResource WindowBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}"
                                                      FontSize="14"
                                                      VerticalAlignment="Center">
                                                <FontIcon.Foreground>
                                                    <SolidColorBrush Color="{x:Bind GlyphColor}" />
                                                </FontIcon.Foreground>
                                            </FontIcon>
                                            <StackPanel Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Description}" />
                                                <TextBlock FontSize="11.5"
                                                           Foreground="{ThemeResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsTextSelectionEnabled="True">
                                                    <Run Text="{x:Bind ShortHash}" FontFamily="{StaticResource MonoFont}" />
                                                    <Run Text="{x:Bind Detail}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    CornerRadius="9"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsLost}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{x:Bind BadgeBackground}" />
                                                </Border.Background>
                                                <TextBlock Text="not on a branch" FontSize="11.5">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{x:Bind BadgeColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Width="90"
                                                       Text="{x:Bind WhenText}"
                                                       FontSize="11.5"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       ToolTipService.ToolTip="{x:Bind WhenTooltip}" />
                                            <StackPanel Grid.Column="4"
                                                        Width="150"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Background="{ThemeResource RaisedBrush}"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{x:Bind IsLost}"
                                                        Click="OnRecoveryRestore"
                                                        Content="Restore as branch"
                                                        ToolTipService.ToolTip="Create a branch at this commit, staying where you are" />
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{x:Bind IsOnBranch}"
                                                        Click="OnRecoveryShowInHistory"
                                                        Content="Show in History" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Text="{x:Bind ViewModel.Recovery.EmptyText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Recovery.IsEmpty, Mode=OneWay}"
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,4" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!--  ═══ File History ═══  -->
            <Grid x:Name="FileHistoryPage"
                  Grid.Column="1"
                  Background="{ThemeResource WindowBrush}"
                  Visibility="{x:Bind ViewModel.ShowFileHistory, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  File picker and the commits that changed the file  -->
                <Grid Background="{ThemeResource SurfaceBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="16,16,16,10" Spacing="10">
                        <TextBlock Text="File history"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <AutoSuggestBox x:Name="FileHistoryPicker"
                                        PlaceholderText="Find a file…"
                                        QueryIcon="Find"
                                        TextChanged="OnFileHistoryPickerTextChanged"
                                        QuerySubmitted="OnFileHistoryPickerSubmitted"
                                        AutomationProperties.Name="File to show the history of" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Padding="16,0,16,10"
                                Visibility="{x:Bind ViewModel.FileHistory.HasPath, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.FileHistory.FileName, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True" />
                            <ProgressRing Grid.Column="1"
                                          IsActive="{x:Bind ViewModel.FileHistory.IsLoading, Mode=OneWay}"
                                          Width="14"
                                          Height="14"
                                          MinWidth="14"
                                          MinHeight="14" />
                        </Grid>
                        <TextBlock FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind ViewModel.FileHistory.Folder, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{x:Bind ViewModel.FileHistory.CountText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Margin="16,4,16,0"
                               Text="Pick a file to see every commit that changed it, following renames. In History, right-click a changed file for the same view."
                               FontSize="12.5"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.FileHistory.HasNoPath, Mode=OneWay}" />
                    <TextBlock Grid.Row="2"
                               Margin="16,4,16,0"
                               Text="{x:Bind ViewModel.FileHistory.ErrorText, Mode=OneWay}"
                               FontSize="12.5"
                               Foreground="{ThemeResource OrangeTextBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Visibility="{x:Bind ViewModel.FileHistory.HasError, Mode=OneWay}" />
                    <ListView x:Name="FileRevisionList"
                              Grid.Row="2"
                              Padding="0,0,0,8"
                              ItemsSource="{x:Bind ViewModel.FileHistory.Revisions}"
                              SelectedItem="{x:Bind ViewModel.FileHistory.Selected, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource RevisionItemStyle}"
                              AutomationProperties.Name="Commits that changed the file">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileRevisionRowViewModel">
                                <StackPanel Padding="10,7" Spacing="2">
                                    <TextBlock Text="{x:Bind Subject}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Subject}" />
                                    <TextBlock FontSize="11.5"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind ShortHash}" FontFamily="{StaticResource MonoFont}" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind Author}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{x:Bind WhenText}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind KindText}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind HasKind}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind KindColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind PathText}"
                                               FontSize="11.5"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind HasPathText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!--  The selected commit's change to the file  -->
                <Grid Grid.Column="1" Background="{ThemeResource RecessedBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="44"
                          Padding="16,0,10,0"
                          ColumnSpacing="10"
                          Style="{StaticResource ToolbarStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.FileHistory.SelectedTitle, Mode=OneWay}"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsTextSelectionEnabled="True" />
                        <!--  The change this commit made, or who wrote each line as of this commit  -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource DeepBrush}"
                                CornerRadius="7"
                                Padding="2"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.FileHistory.HasPath, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="FileHistoryChangeTab"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,3"
                                        Click="OnFileHistoryShowChange"
                                        Content="Change"
                                        FontSize="12"
                                        ToolTipService.ToolTip="What this commit changed in the file" />
                                <Button x:Name="FileHistoryBlameTab"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,3"
                                        Click="OnFileHistoryShowBlame"
                                        Content="Blame"
                                        FontSize="12"
                                        ToolTipService.ToolTip="Who last changed each line, as of this commit" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnFileHistoryShowCommit"
                                Visibility="{x:Bind ViewModel.FileHistory.HasPath, Mode=OneWay}"
                                ToolTipService.ToolTip="Select this commit in History">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                <TextBlock Text="Show in History" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView x:Name="FileHistoryDiffList"
                              Style="{StaticResource DiffListStyle}"
                              Background="{ThemeResource RecessedBrush}"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FileHistory.DiffRows, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource DiffRowSelector}"
                              Visibility="{x:Bind ViewModel.FileHistory.ShowDiff, Mode=OneWay}"
                              AutomationProperties.Name="Change to the file" />
                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.FileHistory.DiffMessage, Mode=OneWay}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.FileHistory.HasVisibleDiffMessage, Mode=OneWay}" />

                    <!--  Blame: a bar per line (stronger = more recent), the commit on the first line of each run  -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.FileHistory.ShowBlame, Mode=OneWay}">
                        <ListView x:Name="BlameList"
                                  Style="{StaticResource DiffListStyle}"
                                  Background="{ThemeResource RecessedBrush}"
                                  ItemsSource="{x:Bind ViewModel.FileHistory.BlameRows, Mode=OneWay}"
                                  AutomationProperties.Name="Blame">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlameRowViewModel">
                                    <Grid MinHeight="22"
                                          MinWidth="{x:Bind MinWidth}"
                                          BorderBrush="{ThemeResource DividerBrush}"
                                          BorderThickness="{x:Bind BlockEdge}"
                                          ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border>
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind BarColor}" />
                                            </Border.Background>
                                        </Border>
                                        <Grid Grid.Column="1"
                                              Padding="10,0,8,0"
                                              ColumnSpacing="8"
                                              Background="{ThemeResource BandBrush}"
                                              DoubleTapped="OnBlameCommitDoubleTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind CommitText}"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind AgeText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextMutedBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Number}"
                                                   Style="{StaticResource LineNumberStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   diff:CodeText.Line="{x:Bind Code}"
                                                   TextWrapping="{x:Bind Wrapping}"
                                                   Style="{StaticResource CodeStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind ViewModel.FileHistory.BlameMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.FileHistory.HasBlameMessage, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>

            <!--  ═══ Compare ═══  -->
            <Grid x:Name="ComparePage"
                  Grid.Column="1"
                  Background="{ThemeResource WindowBrush}"
                  Visibility="{x:Bind ViewModel.ShowCompare, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  The two refs, the summary, and files / commits  -->
                <Grid Background="{ThemeResource SurfaceBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="16,16,16,8" Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Compare"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <ProgressRing Grid.Column="1"
                                          IsActive="{x:Bind ViewModel.Compare.IsLoading, Mode=OneWay}"
                                          Width="14"
                                          Height="14"
                                          MinWidth="14"
                                          MinHeight="14" />
                        </Grid>
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Base"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Compare.Refs, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Compare.Base, Mode=TwoWay}"
                                      AutomationProperties.Name="Base: what the branch is compared against" />
                            <TextBlock Grid.Row="1"
                                       Text="Compare"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Compare.Refs, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Compare.Head, Mode=TwoWay}"
                                      AutomationProperties.Name="Compare: the branch to look at" />
                            <Button Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,0"
                                    VerticalAlignment="Center"
                                    Click="OnCompareSwap"
                                    AutomationProperties.Name="Swap base and compare"
                                    ToolTipService.ToolTip="Swap">
                                <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Padding="16,0,16,10"
                                Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.Compare.SummaryText, Mode=OneWay}"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Compare.TotalsText, Mode=OneWay}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Padding="8,3"
                                Margin="-8,4,0,0"
                                Click="OnCreatePullRequest"
                                ToolTipService.ToolTip="Opens GitHub's new pull request page for Compare into Base">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                <TextBlock Text="Create pull request on GitHub" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.Compare.ErrorText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.Compare.HasError, Mode=OneWay}"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource OrangeTextBrush}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Padding="10,0,10,6"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.Compare.HasComparison, Mode=OneWay}">
                        <Button x:Name="CompareFilesTab"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnCompareShowFiles"
                                Content="{x:Bind ViewModel.Compare.FilesTabText, Mode=OneWay}" />
                        <Button x:Name="CompareCommitsTab"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnCompareShowCommits"
                                Content="{x:Bind ViewModel.Compare.CommitsTabText, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Files  -->
                    <ListView x:Name="CompareFileList"
                              Grid.Row="3"
                              Padding="0,0,0,8"
                              ItemsSource="{x:Bind ViewModel.Compare.Files}"
                              SelectedItem="{x:Bind ViewModel.Compare.SelectedFile, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource FileItemStyle}"
                              Visibility="{x:Bind ViewModel.Compare.ShowFiles, Mode=OneWay}"
                              AutomationProperties.Name="Files the compared branch changes">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangedFileViewModel">
                                <Grid Padding="10,0"
                                      ColumnSpacing="8"
                                      ToolTipService.ToolTip="{x:Bind Model.Path}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="File history"
                                                            Click="OnFileHistoryFromInspector"
                                                            Tag="{x:Bind Model.Path}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE81C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Letter}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind LetterColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12.5">
                                        <Run Text="{x:Bind FileName}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <Run Text="{x:Bind Directory}"
                                             Foreground="{ThemeResource TextMutedBrush}"
                                             FontSize="11.5" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind AddedText}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource GreenTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind DeletedText}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource RedTextBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3"
                               Margin="16,4,16,0"
                               Text="No file differences: the compared branch adds no changes to the base."
                               FontSize="12.5"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.Compare.HasNoFiles, Mode=OneWay}" />

                    <!--  Commits on each side  -->
                    <ScrollViewer Grid.Row="3"
                                  Visibility="{x:Bind ViewModel.Compare.ShowCommits, Mode=OneWay}"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="10,0,10,12" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Compare.AheadTitle, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Compare.HasAhead, Mode=OneWay}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="6,6,0,2" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Compare.Ahead}" ItemTemplate="{StaticResource CompareCommitTemplate}" />
                            <TextBlock Text="{x:Bind ViewModel.Compare.BehindTitle, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Compare.HasBehind, Mode=OneWay}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="6,12,0,2" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Compare.Behind}" ItemTemplate="{StaticResource CompareCommitTemplate}" />
                            <TextBlock Text="{x:Bind ViewModel.Compare.TruncatedText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Compare.IsTruncated, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       Margin="6,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  The selected file's change  -->
                <Grid Grid.Column="1" Background="{ThemeResource RecessedBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="44"
                          Padding="16,0,10,0"
                          Style="{StaticResource ToolbarStyle}">
                        <TextBlock Text="{x:Bind ViewModel.Compare.SelectedFile.Model.Path, Mode=OneWay, FallbackValue=''}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsTextSelectionEnabled="True" />
                    </Grid>
                    <ListView x:Name="CompareDiffList"
                              Style="{StaticResource DiffListStyle}"
                              Background="{ThemeResource RecessedBrush}"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Compare.DiffRows, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource DiffRowSelector}"
                              AutomationProperties.Name="Change to the file" />
                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.Compare.DiffMessage, Mode=OneWay}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.Compare.HasDiffMessage, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!--  ═══ Stash: parked changes ═══  -->
            <Grid x:Name="StashPage"
                  Grid.Column="1"
                  Background="{ThemeResource WindowBrush}"
                  Visibility="{x:Bind ViewModel.ShowStashes, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Stashes, the selected one's actions, and its files  -->
                <Grid Background="{ThemeResource SurfaceBrush}"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,14,10,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Stash"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Changes you set aside. Apply brings them back and keeps the stash; Pop brings them back and removes it."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{StaticResource GhostButtonStyle}"
                                Background="{ThemeResource RaisedBrush}"
                                Click="OnStashAll"
                                IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}"
                                ToolTipService.ToolTip="Stash all uncommitted changes">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                                <TextBlock Text="Stash changes" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="16,4,16,0"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextMutedBrush}"
                               Visibility="{x:Bind ViewModel.Stashes.IsEmpty, Mode=OneWay}"
                               Text="Nothing stashed. When you need a clean working tree without committing, stash your changes from here or from the Changes page." />
                    <ListView x:Name="StashList"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Stashes.Rows}"
                              SelectedItem="{x:Bind ViewModel.Stashes.Selected, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource RevisionItemStyle}"
                              AutomationProperties.Name="Stashes">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StashRowViewModel">
                                <StackPanel Padding="10,7" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock FontSize="11.5"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               ToolTipService.ToolTip="{x:Bind WhenTooltip}">
                                        <Run Text="{x:Bind Name}" FontFamily="{StaticResource MonoFont}" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind Detail}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  Actions on the selected stash  -->
                    <StackPanel Grid.Row="2"
                                Padding="12,8"
                                Orientation="Horizontal"
                                Spacing="6"
                                BorderBrush="{ThemeResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{x:Bind ViewModel.Stashes.HasSelection, Mode=OneWay}">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="30"
                                FontSize="12.5"
                                Click="OnStashPop"
                                Content="Pop"
                                ToolTipService.ToolTip="Bring the changes back and remove the stash" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Background="{ThemeResource RaisedBrush}"
                                Click="OnStashApply"
                                Content="Apply"
                                ToolTipService.ToolTip="Bring the changes back and keep the stash" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Click="OnStashDrop"
                                ToolTipService.ToolTip="Delete this stash (asks first)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;"
                                          FontSize="12"
                                          Foreground="{ThemeResource RedTextBrush}" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="3"
                          Padding="16,6"
                          Style="{StaticResource BandStyle}"
                          BorderThickness="0,1,0,1"
                          Visibility="{x:Bind ViewModel.Stashes.HasSelection, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.Stashes.FilesHeader, Mode=OneWay}" Style="{StaticResource SectionLabelStyle}" />
                    </Grid>
                    <ListView Grid.Row="4"
                              Padding="0,4,0,8"
                              ItemsSource="{x:Bind ViewModel.Stashes.Files}"
                              SelectedItem="{x:Bind ViewModel.Stashes.SelectedFile, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource FileItemStyle}"
                              ItemTemplate="{StaticResource ChangedFileTemplate}"
                              AutomationProperties.Name="Files in the stash" />
                </Grid>

                <!--  The selected file's change  -->
                <Grid Grid.Column="1" Background="{ThemeResource RecessedBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="44"
                          Padding="16,0,10,0"
                          Style="{StaticResource ToolbarStyle}">
                        <TextBlock Text="{x:Bind ViewModel.Stashes.SelectedFile.Model.Path, Mode=OneWay, FallbackValue=''}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsTextSelectionEnabled="True" />
                    </Grid>
                    <ListView Grid.Row="1"
                              Style="{StaticResource DiffListStyle}"
                              Background="{ThemeResource RecessedBrush}"
                              ItemsSource="{x:Bind ViewModel.Stashes.DiffRows, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource DiffRowSelector}"
                              AutomationProperties.Name="Change in the stash" />
                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.Stashes.DiffMessage, Mode=OneWay}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.Stashes.HasDiffMessage, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!--  Sidebar edge: drawn over the seam the sidebar already has  -->
            <controls:Splitter x:Name="SidebarSplitter"
                               Grid.Column="1"
                               Orientation="Vertical"
                               ShowLine="False"
                               Width="6"
                               HorizontalAlignment="Left"
                               Margin="-3,0,0,0"
                               ToolTipService.ToolTip="Drag to resize the sidebar · double-click to reset" />

            <!--  ═══ Settings (covers the body; Esc or Back returns) ═══  -->
            <Grid x:Name="SettingsPage"
                  Grid.ColumnSpan="2"
                  Background="{ThemeResource WindowBrush}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,0,20,0"
                      BorderBrush="{ThemeResource SeamBrush}"
                      BorderThickness="0,0,0,1"
                      ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Click="OnCloseSettings"
                                AutomationProperties.Name="Back">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                <TextBlock Text="{x:Bind Settings.BackText, Mode=OneWay}" />
                                <Border Background="{ThemeResource RaisedBrush}"
                                        CornerRadius="4"
                                        Padding="5,0">
                                    <TextBlock Text="Esc"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="/"
                                   Foreground="{ThemeResource TextFaintBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Settings"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind Settings.ToolsText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Padding="8,12"
                                Spacing="1"
                                BorderBrush="{ThemeResource SeamBrush}"
                                BorderThickness="0,0,1,0">
                        <Button x:Name="SettingsRepositoriesNav"
                                Style="{StaticResource NavButtonStyle}"
                                Click="OnSettingsRepositories">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                <TextBlock Text="Repositories" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsAccountsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Click="OnSettingsAccounts">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE77B;" FontSize="15" />
                                <TextBlock Text="Accounts" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsAppearanceNav"
                                Style="{StaticResource NavButtonStyle}"
                                Click="OnSettingsAppearance"
                                AutomationProperties.Name="Appearance settings">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE790;" FontSize="15" />
                                <TextBlock Text="Appearance" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsAboutNav"
                                Style="{StaticResource NavButtonStyle}"
                                Click="OnSettingsAbout"
                                AutomationProperties.Name="About and updates">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="15" />
                                <TextBlock Text="About" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer x:Name="SettingsScroller"
                                  Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Padding="32,24,32,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="900" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Repositories  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind Settings.IsRepositories, Mode=OneWay}">
                                <TextBlock Text="Repositories"
                                           FontSize="20"
                                           FontWeight="SemiBold" />

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Scan folders" Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="The switcher (Ctrl+P) offers every repository found below these folders." Style="{StaticResource CardHintStyle}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Background="{ThemeResource RaisedBrush}"
                                                        Click="OnAddScanFolder">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                        <TextBlock Text="Add folder…" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Click="OnRescan"
                                                        IsEnabled="{x:Bind Settings.IsIdle, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                        <TextBlock Text="Rescan" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Settings.ScanFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ScanFolderViewModel">
                                                    <Grid Height="38"
                                                          Padding="12,0,4,0"
                                                          Margin="0,2"
                                                          CornerRadius="6"
                                                          Background="{ThemeResource RaisedBrush}"
                                                          ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE8B7;"
                                                                  FontSize="14"
                                                                  Foreground="{ThemeResource TextMutedBrush}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind Path}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="12.5"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind MissingText}"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource OrangeTextBrush}" />
                                                            <TextBlock Text="{x:Bind CountText}"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Padding="8,6"
                                                                Tag="{x:Bind Path}"
                                                                Click="OnRemoveScanFolder"
                                                                ToolTipService.ToolTip="Stop scanning this folder"
                                                                AutomationProperties.Name="Remove scan folder">
                                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Discovery" Style="{StaticResource CardTitleStyle}" />
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Scan depth" FontSize="13" />
                                                <TextBlock Text="How many folder levels below each scan folder" Style="{StaticResource CardHintStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource DeepBrush}"
                                                    CornerRadius="7"
                                                    Padding="2"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Padding="10,3"
                                                            Content="−"
                                                            Click="OnDepthDown"
                                                            AutomationProperties.Name="Less deep" />
                                                    <TextBlock Text="{x:Bind Settings.ScanDepthText, Mode=OneWay}"
                                                               Width="28"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Padding="10,3"
                                                            Content="+"
                                                            Click="OnDepthUp"
                                                            AutomationProperties.Name="Deeper" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Include worktrees" FontSize="13" />
                                                <TextBlock Text="List linked worktrees as repositories of their own" Style="{StaticResource CardHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsOn="{x:Bind Settings.IncludeWorktrees, Mode=TwoWay}"
                                                          OnContent=""
                                                          OffContent=""
                                                          MinWidth="0" />
                                        </Grid>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Skip folders named" FontSize="13" />
                                            <TextBox Text="{x:Bind Settings.SkipNames, Mode=TwoWay}"
                                                     LostFocus="OnSkipNamesCommitted"
                                                     KeyDown="OnSkipNamesKeyDown"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="12"
                                                     PlaceholderText="node_modules, bin, obj"
                                                     AutomationProperties.Name="Skip folders named" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="14">
                                        <StackPanel>
                                            <TextBlock Text="Background sync" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Fetch only — never pulls, merges or rebases on its own" Style="{StaticResource CardHintStyle}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Fetch the open repository in the background" FontSize="13" />
                                                <TextBlock Text="Keeps ahead / behind counts current; runs only while CentralGit is open" Style="{StaticResource CardHintStyle}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      MinWidth="170"
                                                      ItemsSource="{x:Bind Settings.FetchIntervalLabels}"
                                                      SelectedIndex="{x:Bind Settings.FetchIntervalIndex, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind Settings.BackgroundFetch, Mode=OneWay}"
                                                      AutomationProperties.Name="Background fetch interval" />
                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind Settings.BackgroundFetch, Mode=TwoWay}"
                                                          OnContent=""
                                                          OffContent=""
                                                          MinWidth="0"
                                                          AutomationProperties.Name="Background fetch" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Text="Discovered repositories" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind Settings.DiscoveredSummary, Mode=OneWay}" Style="{StaticResource CardHintStyle}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind Settings.Repositories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RepositoryToggleViewModel">
                                                    <Grid Height="32"
                                                          ColumnSpacing="10"
                                                          Padding="4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{x:Bind IsShown, Mode=TwoWay}"
                                                                  MinWidth="0"
                                                                  Padding="0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTipService.ToolTip="Show in the switcher"
                                                                  AutomationProperties.Name="{x:Bind Name}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind Name}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{x:Bind Location}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{x:Bind Kind}"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource InfoBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  Appearance  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind Settings.IsAppearance, Mode=OneWay}">
                                <TextBlock Text="Appearance"
                                           FontSize="20"
                                           FontWeight="SemiBold" />

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="14">
                                        <StackPanel>
                                            <TextBlock Text="Theme" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Switches right away. Colors keep their meaning in every theme: violet is you, orange needs attention, green is done." Style="{StaticResource CardHintStyle}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind Settings.ThemeChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="14" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Height="Auto"
                                                            Padding="6"
                                                            Width="236"
                                                            CornerRadius="12"
                                                            HorizontalContentAlignment="Stretch"
                                                            Tag="{x:Bind Tag}"
                                                            Click="OnThemeChoice"
                                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                                        <StackPanel Spacing="8">
                                                            <Border CornerRadius="9"
                                                                    BorderThickness="2"
                                                                    Padding="1">
                                                                <Border.BorderBrush>
                                                                    <SolidColorBrush Color="{x:Bind BorderColor}" />
                                                                </Border.BorderBrush>
                                                                <!--  Miniature window: title bar, sidebar, history rows  -->
                                                                <Grid Height="112" CornerRadius="7">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="14" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="58" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.Background>
                                                                        <SolidColorBrush Color="{x:Bind ContentColor}" />
                                                                    </Grid.Background>
                                                                    <Border Grid.ColumnSpan="2">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{x:Bind ChromeColor}" />
                                                                        </Border.Background>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="3"
                                                                                    Margin="6,0"
                                                                                    VerticalAlignment="Center">
                                                                            <Ellipse Width="5" Height="5">
                                                                                <Ellipse.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind Accent}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Rectangle Width="26"
                                                                                       Height="3"
                                                                                       RadiusX="1.5"
                                                                                       RadiusY="1.5"
                                                                                       VerticalAlignment="Center">
                                                                                <Rectangle.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind SidebarLine}" />
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <StackPanel Grid.Row="1"
                                                                                Spacing="6"
                                                                                Padding="7,9">
                                                                        <StackPanel.Background>
                                                                            <SolidColorBrush Color="{x:Bind SidebarColor}" />
                                                                        </StackPanel.Background>
                                                                        <Rectangle Height="3"
                                                                                   Width="34"
                                                                                   HorizontalAlignment="Left"
                                                                                   RadiusX="1.5"
                                                                                   RadiusY="1.5">
                                                                            <Rectangle.Fill>
                                                                                <SolidColorBrush Color="{x:Bind Accent}" />
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                        <Rectangle Height="3"
                                                                                   Width="40"
                                                                                   HorizontalAlignment="Left"
                                                                                   RadiusX="1.5"
                                                                                   RadiusY="1.5">
                                                                            <Rectangle.Fill>
                                                                                <SolidColorBrush Color="{x:Bind SidebarLine}" />
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                        <Rectangle Height="3"
                                                                                   Width="28"
                                                                                   HorizontalAlignment="Left"
                                                                                   RadiusX="1.5"
                                                                                   RadiusY="1.5">
                                                                            <Rectangle.Fill>
                                                                                <SolidColorBrush Color="{x:Bind SidebarLine}" />
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                        <Rectangle Height="3"
                                                                                   Width="36"
                                                                                   HorizontalAlignment="Left"
                                                                                   RadiusX="1.5"
                                                                                   RadiusY="1.5">
                                                                            <Rectangle.Fill>
                                                                                <SolidColorBrush Color="{x:Bind SidebarLine}" />
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="1"
                                                                                Grid.Column="1"
                                                                                Spacing="9"
                                                                                Padding="10,10">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <Ellipse Width="7" Height="7">
                                                                                <Ellipse.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind Attention}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Rectangle Width="62"
                                                                                       Height="4"
                                                                                       RadiusX="2"
                                                                                       RadiusY="2"
                                                                                       VerticalAlignment="Center">
                                                                                <Rectangle.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind ContentLine}" />
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <Ellipse Width="7" Height="7">
                                                                                <Ellipse.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind Accent}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Rectangle Width="94"
                                                                                       Height="4"
                                                                                       RadiusX="2"
                                                                                       RadiusY="2"
                                                                                       VerticalAlignment="Center">
                                                                                <Rectangle.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind ContentStrong}" />
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <Ellipse Width="7" Height="7">
                                                                                <Ellipse.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind Accent}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Rectangle Width="74"
                                                                                       Height="4"
                                                                                       RadiusX="2"
                                                                                       RadiusY="2"
                                                                                       VerticalAlignment="Center">
                                                                                <Rectangle.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind ContentLine}" />
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <Ellipse Width="7" Height="7">
                                                                                <Ellipse.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind ContentLine}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Rectangle Width="84"
                                                                                       Height="4"
                                                                                       RadiusX="2"
                                                                                       RadiusY="2"
                                                                                       VerticalAlignment="Center">
                                                                                <Rectangle.Fill>
                                                                                    <SolidColorBrush Color="{x:Bind ContentLine}" />
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Padding="4,0,4,4">
                                                                <TextBlock Text="{x:Bind Title}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CardHintStyle}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnSpacing="16"
                                              Margin="0,4,0,0"
                                              Visibility="{x:Bind Settings.CanChooseChrome, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Dark title bar, sidebar and status bar" FontSize="13" />
                                                <TextBlock Text="Keeps the frame dark so the light pages stand out" Style="{StaticResource CardHintStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsOn="{x:Bind Settings.DarkChromeInLight, Mode=TwoWay}"
                                                          OnContent=""
                                                          OffContent=""
                                                          MinWidth="0"
                                                          AutomationProperties.Name="Keep the frame dark" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  About  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind Settings.IsAbout, Mode=OneWay}">
                                <TextBlock Text="About"
                                           FontSize="20"
                                           FontWeight="SemiBold" />

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Updates.VersionText, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing Visibility="{x:Bind Updates.IsWorking, Mode=OneWay}"
                                                              IsActive="{x:Bind Updates.IsWorking, Mode=OneWay}"
                                                              Width="12"
                                                              Height="12"
                                                              MinWidth="12"
                                                              MinHeight="12"
                                                              Foreground="{ThemeResource TealBrush}" />
                                                <TextBlock Text="{x:Bind Updates.StatusText, Mode=OneWay}"
                                                           Style="{StaticResource CardHintStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Top">
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource RaisedBrush}"
                                                    Visibility="{x:Bind Updates.CanCheck, Mode=OneWay}"
                                                    Click="OnCheckForUpdates"
                                                    Content="Check for updates" />
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Visibility="{x:Bind Updates.IsReady, Mode=OneWay}"
                                                    Click="OnRestartToUpdate"
                                                    Content="Restart now" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!--  Accounts  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind Settings.IsAccounts, Mode=OneWay}">
                                <TextBlock Text="Accounts"
                                           FontSize="20"
                                           FontWeight="SemiBold" />

                                <Border Background="{ThemeResource OrangeTintBrush}"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Visibility="{x:Bind Settings.CredentialManagerMissing, Mode=OneWay}">
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource OrangeTextBrush}"
                                               Text="Git Credential Manager was not found. It ships with Git for Windows — reinstall or update Git (winget upgrade Git.Git) to sign in to hosting services." />
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Text="Hosting accounts" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Stored by Git Credential Manager in Windows Credential Manager. CentralGit never sees or keeps your tokens." Style="{StaticResource CardHintStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="No signed-in hosts yet."
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   Visibility="{x:Bind Settings.HasNoAccounts, Mode=OneWay}" />
                                        <ItemsControl ItemsSource="{x:Bind Settings.Accounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AccountViewModel">
                                                    <Grid Height="48"
                                                          Padding="10,0,4,0"
                                                          Margin="0,2"
                                                          CornerRadius="6"
                                                          Background="{ThemeResource RaisedBrush}"
                                                          ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30"
                                                                Height="30"
                                                                CornerRadius="8"
                                                                Background="{ThemeResource ElevatedBrush}">
                                                            <TextBlock Text="{x:Bind Initial}"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="1">
                                                            <TextBlock FontSize="13">
                                                                <Run Text="{x:Bind Provider}" />
                                                                <Run Text="  " />
                                                                <Run Text="{x:Bind UserName}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{x:Bind Scope}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11.5"
                                                                       Foreground="{ThemeResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Tag="{x:Bind}"
                                                                Click="OnSignOut"
                                                                Content="Sign out"
                                                                ToolTipService.ToolTip="git credential reject — removes the stored credential" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="Connect:"
                                                       FontSize="12.5"
                                                       Foreground="{ThemeResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource RaisedBrush}"
                                                    Content="GitHub"
                                                    Tag="https://github.com"
                                                    Click="OnSignIn" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource RaisedBrush}"
                                                    Content="GitLab"
                                                    Tag="https://gitlab.com"
                                                    Click="OnSignIn" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource RaisedBrush}"
                                                    Content="Azure DevOps"
                                                    Tag="https://dev.azure.com"
                                                    Click="OnSignIn" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource RaisedBrush}"
                                                    Content="Bitbucket"
                                                    Tag="https://bitbucket.org"
                                                    Click="OnSignIn" />
                                            <TextBox Width="220"
                                                     Height="30"
                                                     FontSize="12"
                                                     PlaceholderText="Other host, e.g. git.company.com"
                                                     Text="{x:Bind Settings.OtherHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Other host"
                                                     Margin="6,0,0,0" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource RaisedBrush}"
                                                    Content="Connect"
                                                    Click="OnSignInOther" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Settings.AccountsMessage, Mode=OneWay}"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind Settings.HasAccountsMessage, Mode=OneWay}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind Settings.AccountsMessageColor, Mode=OneWay}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel>
                                            <TextBlock Text="Commit identity" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Style="{StaticResource CardHintStyle}">
                                                <Run Text="Saved as" />
                                                <Run Text="user.name" FontFamily="{StaticResource MonoFont}" />
                                                <Run Text="/" />
                                                <Run Text="user.email" FontFamily="{StaticResource MonoFont}" />
                                                <Run Text="in %USERPROFILE%\.gitconfig — the same values the command line uses." />
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="Name"
                                                     Text="{x:Bind Settings.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" />
                                            <TextBox Grid.Column="1"
                                                     Header="Email"
                                                     Text="{x:Bind Settings.UserEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Background="{ThemeResource VioletTintBrush}"
                                                    VerticalAlignment="Bottom"
                                                    Click="OnSaveIdentity">
                                                <TextBlock Text="Save" Foreground="{ThemeResource VioletTextBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Settings.IdentityMessage, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!--  ═══ Status bar ═══  -->
        <Grid x:Name="StatusBar"
              Grid.Row="2"
              Background="{ThemeResource DeepBrush}"
              BorderBrush="{ThemeResource SeamBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,0,12,0"
              ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D5;"
                          FontSize="12"
                          Foreground="{ThemeResource VioletBrush}" />
                <TextBlock Text="{x:Bind ViewModel.UpstreamSummary, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <!--  GitHub: the branch's pull request and the checks on HEAD  -->
                <Button Style="{StaticResource GhostButtonStyle}"
                        Padding="6,1"
                        Margin="4,0,0,0"
                        Visibility="{x:Bind ViewModel.HasPullRequest, Mode=OneWay}"
                        Click="OnOpenPullRequest"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PullRequestTooltip, Mode=OneWay}"
                        AutomationProperties.Name="Open pull request">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8AB;"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PullRequestText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <FontIcon Glyph="{x:Bind ViewModel.HeadChecksGlyph, Mode=OneWay}"
                                  FontSize="11"
                                  Visibility="{x:Bind ViewModel.HasHeadChecks, Mode=OneWay}">
                            <FontIcon.Foreground>
                                <SolidColorBrush Color="{x:Bind ViewModel.HeadChecksColor, Mode=OneWay}" />
                            </FontIcon.Foreground>
                        </FontIcon>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Rectangle Grid.Column="1"
                       Width="1"
                       Height="14"
                       Fill="{ThemeResource ControlBorderBrush}" />
            <!--  Operations Center: the status line opens the panel of recent operations.  -->
            <Button x:Name="OperationsButton"
                    Grid.Column="2"
                    Style="{StaticResource GhostButtonStyle}"
                    Padding="6,1"
                    Margin="-6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Operations"
                    ToolTipService.ToolTip="Recent operations (exact commands and output)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ProgressRing Visibility="{x:Bind ViewModel.Operations.IsBusy, Mode=OneWay}"
                                  IsActive="{x:Bind ViewModel.Operations.IsBusy, Mode=OneWay}"
                                  Width="12"
                                  Height="12"
                                  MinWidth="12"
                                  MinHeight="12"
                                  Foreground="{ThemeResource TealBrush}" />
                    <TextBlock Visibility="{x:Bind ViewModel.Operations.IsBusy, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run Text="{x:Bind ViewModel.Operations.Latest.Title, Mode=OneWay, FallbackValue=''}" />
                        <Run Text="  ·  " Foreground="{ThemeResource TextMutedBrush}" />
                        <Run Text="{x:Bind ViewModel.Operations.Latest.Phase, Mode=OneWay, FallbackValue=''}" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock x:Name="StatusLine"
                               Visibility="{x:Bind ViewModel.Operations.IsIdle, Mode=OneWay}"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="OperationsFlyout" Placement="TopEdgeAlignedLeft">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource SeamBrush}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="MaxWidth" Value="640" />
                                <Setter Property="MaxHeight" Value="620" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid Width="580">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="16,12,10,10"
                                  BorderBrush="{ThemeResource SeamBrush}"
                                  BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="Operations"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Every fetch, pull and push, with the exact command git ran"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="Cancel"
                                        Visibility="{x:Bind ViewModel.Operations.IsBusy, Mode=OneWay}"
                                        Click="OnCancelOperation"
                                        AutomationProperties.Name="Cancel operation" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Visibility="{x:Bind ViewModel.Operations.HasNoRecent, Mode=OneWay}"
                                       Margin="16,18"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       Text="Nothing has run yet. Fetch, Pull and Push appear here with live progress, and failures with a plain explanation and a suggested next step." />
                            <ScrollViewer Grid.Row="1"
                                          Visibility="{x:Bind ViewModel.Operations.HasRecent, Mode=OneWay}"
                                          HorizontalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Operations.Recent}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OperationViewModel">
                                            <StackPanel Padding="16,12"
                                                        Spacing="6"
                                                        BorderBrush="{ThemeResource SeamBrush}"
                                                        BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                              FontSize="13"
                                                              VerticalAlignment="Center">
                                                        <FontIcon.Foreground>
                                                            <SolidColorBrush Color="{x:Bind StateColor, Mode=OneWay}" />
                                                        </FontIcon.Foreground>
                                                    </FontIcon>
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{x:Bind Title}" />
                                                        <Run Text="{x:Bind BackgroundSuffix}"
                                                             FontWeight="Normal"
                                                             Foreground="{ThemeResource TextMutedBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextMutedBrush}"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{x:Bind StartedText}" />
                                                        <Run Text="{x:Bind DurationSuffix, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{x:Bind CommandLine}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11.5"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <StackPanel Visibility="{x:Bind IsRunning, Mode=OneWay}" Spacing="4">
                                                    <ProgressBar IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                                 Value="{x:Bind Percent, Mode=OneWay}"
                                                                 Maximum="100"
                                                                 Foreground="{ThemeResource TealBrush}" />
                                                    <TextBlock Text="{x:Bind Phase, Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Visibility="{x:Bind IsFailed, Mode=OneWay}"
                                                            Spacing="2"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="{x:Bind ExplanationTitle, Mode=OneWay}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource RedTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ExplanationDetail, Mode=OneWay}"
                                                               FontSize="12.5"
                                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6"
                                                            Margin="0,2,0,0">
                                                    <ItemsControl ItemsSource="{x:Bind Actions, Mode=OneWay}" Visibility="{x:Bind HasActions, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:OperationAction">
                                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                                        Content="{x:Bind Label}"
                                                                        Tag="{x:Bind}"
                                                                        Click="OnOperationAction"
                                                                        Padding="10,4"
                                                                        AutomationProperties.Name="{x:Bind Label}">
                                                                    <Button.Background>
                                                                        <SolidColorBrush Color="{x:Bind Background}" />
                                                                    </Button.Background>
                                                                    <Button.Foreground>
                                                                        <SolidColorBrush Color="{x:Bind Foreground}" />
                                                                    </Button.Foreground>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Visibility="{x:Bind HasOutput, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            Click="OnCopyOperationOutput"
                                                            Padding="8,4"
                                                            AutomationProperties.Name="Copy command and output"
                                                            ToolTipService.ToolTip="Copy the command and git's full output">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                            <TextBlock Text="Copy output" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <Border Visibility="{x:Bind HasOutput, Mode=OneWay}"
                                                        Background="{ThemeResource DeepBrush}"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        MaxHeight="160">
                                                    <ScrollViewer HorizontalScrollMode="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{x:Bind Output, Mode=OneWay}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11.5"
                                                                   IsTextSelectionEnabled="True"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <!--  A downloaded update waits for a restart: violet = an action for you.  -->
                <Button Style="{StaticResource GhostButtonStyle}"
                        Visibility="{x:Bind Updates.IsReady, Mode=OneWay}"
                        Height="22"
                        Padding="8,0"
                        Background="{ThemeResource VioletTintBrush}"
                        Click="OnRestartToUpdate"
                        ToolTipService.ToolTip="Install the downloaded update and restart CentralGit">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;"
                                  FontSize="11"
                                  Foreground="{ThemeResource VioletBrush}" />
                        <TextBlock Text="{x:Bind Updates.RestartText, Mode=OneWay}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}"
                        Height="22"
                        Padding="6,0"
                        Click="OnOpenAbout"
                        ToolTipService.ToolTip="About and updates">
                    <TextBlock Text="{x:Bind Updates.VersionText, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextMutedBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  ═══ Repository switcher (Ctrl+P) ═══  -->
        <Grid x:Name="SwitcherOverlay"
              Grid.RowSpan="3"
              Background="{ThemeResource ScrimBrush}"
              Visibility="Collapsed"
              Canvas.ZIndex="10"
              Tapped="OnSwitcherBackdropTapped">
            <Border x:Name="SwitcherCard"
                    Width="640"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,72,0,0"
                    Background="{ThemeResource RaisedBrush}"
                    BorderBrush="{ThemeResource SeamBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Tapped="OnSwitcherCardTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SwitcherBox"
                             Margin="10,10,10,6"
                             Height="36"
                             FontSize="14"
                             CornerRadius="7"
                             PlaceholderText="Open repository…"
                             AutomationProperties.Name="Repository search"
                             Text="{x:Bind Switcher.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSwitcherKeyDown" />
                    <ListView x:Name="SwitcherList"
                              Grid.Row="1"
                              MaxHeight="420"
                              Padding="0,0,0,4"
                              ItemsSource="{x:Bind Switcher.Results, Mode=OneWay}"
                              SelectedItem="{x:Bind Switcher.Selected, Mode=TwoWay}"
                              IsItemClickEnabled="True"
                              ItemClick="OnSwitcherItemClick"
                              ItemContainerStyle="{StaticResource SwitcherItemStyle}"
                              AutomationProperties.Name="Repositories">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SwitcherItemViewModel">
                                <Grid Padding="10,0"
                                      ColumnSpacing="10"
                                      Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextMutedBrush}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind NameColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Location}"
                                                   FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SyncText, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource VioletTextBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="Commits ahead / behind its upstream" />
                                        <Border Visibility="{x:Bind HasChanges, Mode=OneWay}"
                                                Background="{ThemeResource OrangeTintBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                ToolTipService.ToolTip="Uncommitted files in this repository">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="{ThemeResource OrangeBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ChangesText, Mode=OneWay}"
                                                           FontSize="11.5"
                                                           Foreground="{ThemeResource OrangeTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{x:Bind Badge}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind BadgeColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2"
                          Padding="14,0"
                          BorderBrush="{ThemeResource DividerBrush}"
                          BorderThickness="0,1,0,0">
                        <TextBlock Text="{x:Bind Switcher.Hint, Mode=OneWay}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton HorizontalAlignment="Right"
                                         Padding="4,0"
                                         FontSize="11.5"
                                         Content="Manage scan folders…"
                                         Click="OnSwitcherManage" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  ═══ Command palette (Ctrl+K) ═══  -->
        <Grid x:Name="PaletteOverlay"
              Grid.RowSpan="3"
              Background="{ThemeResource ScrimBrush}"
              Visibility="Collapsed"
              Canvas.ZIndex="10"
              Tapped="OnPaletteBackdropTapped">
            <Border Width="640"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,72,0,0"
                    Background="{ThemeResource RaisedBrush}"
                    BorderBrush="{ThemeResource SeamBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Tapped="OnSwitcherCardTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteBox"
                             Margin="10,10,10,6"
                             Height="36"
                             FontSize="14"
                             CornerRadius="7"
                             PlaceholderText="Run a command, or find a branch, tag or commit…"
                             AutomationProperties.Name="Command search"
                             Text="{x:Bind CommandPalette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnPaletteKeyDown" />
                    <ListView x:Name="PaletteList"
                              Grid.Row="1"
                              MaxHeight="440"
                              Padding="0,0,0,4"
                              ItemsSource="{x:Bind CommandPalette.Results, Mode=OneWay}"
                              SelectedItem="{x:Bind CommandPalette.Selected, Mode=TwoWay}"
                              IsItemClickEnabled="True"
                              ItemClick="OnPaletteItemClick"
                              ItemContainerStyle="{StaticResource SwitcherItemStyle}"
                              AutomationProperties.Name="Commands">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteItemViewModel">
                                <Grid Padding="10,0"
                                      ColumnSpacing="10"
                                      Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}"
                                              FontSize="13"
                                              Foreground="{ThemeResource TextMutedBrush}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   Visibility="{x:Bind HasDetail}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Shortcut}"
                                                   Visibility="{x:Bind HasShortcut}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource TextFaintBrush}" />
                                        <TextBlock Text="{x:Bind Group}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2"
                          Padding="14,0"
                          BorderBrush="{ThemeResource DividerBrush}"
                          BorderThickness="0,1,0,0">
                        <TextBlock Text="{x:Bind CommandPalette.Hint, Mode=OneWay}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

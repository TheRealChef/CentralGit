<Window
    x:Class="CentralGit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CentralGit.App.ViewModels"
    xmlns:graph="using:CentralGit.App.Graph"
    xmlns:diff="using:CentralGit.App.Diff"
    xmlns:controls="using:CentralGit.App.Controls"
    Title="CentralGit">

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFilterAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnNextChangeAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnPreviousChangeAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <diff:DiffTemplateSelector x:Key="DiffRowSelector">
                <diff:DiffTemplateSelector.SplitTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Grid Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border><Border.Background><SolidColorBrush Color="{x:Bind LeftGutter}" /></Border.Background>
                                <TextBlock Text="{x:Bind LeftNumber}" Style="{StaticResource LineNumberStyle}" />
                            </Border>
                            <Border Grid.Column="1"><Border.Background><SolidColorBrush Color="{x:Bind LeftBackground}" /></Border.Background>
                                <TextBlock diff:CodeText.Line="{x:Bind Left}" Style="{StaticResource CodeStyle}" />
                            </Border>
                            <Rectangle Grid.Column="2" Fill="{StaticResource SeamBrush}" />
                            <Border Grid.Column="3"><Border.Background><SolidColorBrush Color="{x:Bind RightGutter}" /></Border.Background>
                                <TextBlock Text="{x:Bind RightNumber}" Style="{StaticResource LineNumberStyle}" />
                            </Border>
                            <Border Grid.Column="4"><Border.Background><SolidColorBrush Color="{x:Bind RightBackground}" /></Border.Background>
                                <TextBlock diff:CodeText.Line="{x:Bind Right}" Style="{StaticResource CodeStyle}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </diff:DiffTemplateSelector.SplitTemplate>
                <diff:DiffTemplateSelector.UnifiedTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Grid Height="20">
                            <Grid.Background><SolidColorBrush Color="{x:Bind LeftBackground}" /></Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2"><Border.Background><SolidColorBrush Color="{x:Bind LeftGutter}" /></Border.Background></Border>
                            <TextBlock Text="{x:Bind LeftNumber}" Style="{StaticResource LineNumberStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind RightNumber}" Style="{StaticResource LineNumberStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Sign}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground><SolidColorBrush Color="{x:Bind SignColor}" /></TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Grid.Column="3" diff:CodeText.Line="{x:Bind Left}" Style="{StaticResource CodeStyle}" Padding="0" />
                        </Grid>
                    </DataTemplate>
                </diff:DiffTemplateSelector.UnifiedTemplate>
                <diff:DiffTemplateSelector.HunkTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Border Height="24" Background="#FF262A31" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1">
                            <TextBlock Text="{x:Bind Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#FF8EA3BF"
                                       VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DataTemplate>
                </diff:DiffTemplateSelector.HunkTemplate>
                <diff:DiffTemplateSelector.GapTemplate>
                    <DataTemplate x:DataType="diff:DiffRowViewModel">
                        <Border Height="22" Background="#FF1E2126">
                            <TextBlock Text="{x:Bind Text}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0" />
                        </Border>
                    </DataTemplate>
                </diff:DiffTemplateSelector.GapTemplate>
            </diff:DiffTemplateSelector>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══ Title bar ═══ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource DeepBrush}" BorderBrush="#FF0F1013" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Padding="12,0,0,0">
                <!-- App mark: Assets/AppIcon.svg geometry, cropped to the mark (the title bar is already the icon's #17191D) -->
                <Viewbox Width="24" Height="24" Margin="0,0,8,0" AutomationProperties.Name="CentralGit">
                    <Canvas Width="320" Height="320">
                        <Canvas.RenderTransform><TranslateTransform X="-85" Y="-96" /></Canvas.RenderTransform>
                        <Path Data="M354,158 C329,133 298,120 260,120 C185,120 126,180 126,256 C126,332 185,392 260,392 C298,392 329,379 354,354"
                              Stroke="#FF9B83C9" StrokeThickness="32" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="328" Canvas.Top="132" Width="52" Height="52" Fill="#FF9B83C9" />
                        <Ellipse Canvas.Left="344" Canvas.Top="148" Width="20" Height="20" Fill="#FF17191D" />
                        <Ellipse Canvas.Left="328" Canvas.Top="328" Width="52" Height="52" Fill="#FF9B83C9" />
                        <Ellipse Canvas.Left="344" Canvas.Top="344" Width="20" Height="20" Fill="#FF17191D" />
                        <Path Data="M236,196 L236,320" Stroke="#FF9B83C9" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="M236,284 C236,260 306,260 306,224 L306,206" Stroke="#FFD98A57" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Ellipse Canvas.Left="214" Canvas.Top="174" Width="44" Height="44" Fill="#FF9B83C9" />
                        <Ellipse Canvas.Left="227" Canvas.Top="187" Width="18" Height="18" Fill="#FF17191D" />
                        <Ellipse Canvas.Left="283" Canvas.Top="183" Width="46" Height="46" Fill="#FFD98A57" />
                        <Ellipse Canvas.Left="296" Canvas.Top="196" Width="20" Height="20" Fill="#FF17191D" />
                        <Ellipse Canvas.Left="210" Canvas.Top="294" Width="52" Height="52" Fill="#FFCDBEEB" />
                        <Ellipse Canvas.Left="225" Canvas.Top="309" Width="22" Height="22" Fill="#FF17191D" />
                    </Canvas>
                </Viewbox>
                <Button x:Name="RepoButton" Style="{StaticResource GhostButtonStyle}" Background="{StaticResource SurfaceBrush}"
                        ToolTipService.ToolTip="Switch repository (Ctrl+P)" AutomationProperties.Name="Switch repository">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="/" Foreground="#FF4B515B" VerticalAlignment="Center" Margin="2,0" />
                <Button x:Name="BranchButton" Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="Switch branch">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE9D5;" FontSize="13" Foreground="{StaticResource VioletBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BranchName, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.BranchName, Mode=OneWay}" />
                        <Border Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}" Background="{StaticResource OrangeTintBrush}" CornerRadius="4" Padding="6,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="#FFD98A57" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ChangedFilesText, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource OrangeTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBox x:Name="CommandBox" Grid.Column="1" VerticalAlignment="Center" Height="32" CornerRadius="6"
                     MaxWidth="460" Margin="16,0" HorizontalAlignment="Stretch"
                     PlaceholderText="Search commits, branches, files, or run a command   (Ctrl+K)"
                     FontSize="12.5" AutomationProperties.Name="Command palette" />

            <StackPanel x:Name="SyncPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                <Button Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.FetchCommand}" ToolTipService.ToolTip="git fetch --all --prune">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Fetch" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Pull arrives with the Operations Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74B;" FontSize="13" />
                        <TextBlock Text="Pull" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}" IsEnabled="False" Background="{StaticResource VioletTintBrush}" ToolTipService.ToolTip="Push arrives with the Operations Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" Foreground="{StaticResource VioletTextBrush}" />
                        <TextBlock Text="Push" Foreground="{StaticResource VioletTextBrush}" />
                        <Border Visibility="{x:Bind ViewModel.HasAhead, Mode=OneWay}" Background="{StaticResource VioletBrush}" CornerRadius="4" Padding="5,0">
                            <TextBlock Text="{x:Bind ViewModel.AheadText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DeepBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Body ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="{StaticResource WindowBrush}" BorderBrush="#FF0F1013" BorderThickness="0,0,1,0" Padding="8,10,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="1">
                    <Button Style="{StaticResource NavButtonStyle}" Background="{StaticResource RaisedBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="{StaticResource VioletBrush}" />
                            <TextBlock Text="History" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                                <TextBlock Text="Changes" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.ChangedFilesText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource OrangeTextBrush}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8AB;" FontSize="15" /><TextBlock Text="Compare" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7C3;" FontSize="15" /><TextBlock Text="File History" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7A7;" FontSize="15" /><TextBlock Text="Recovery" /></StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="BRANCHES" Style="{StaticResource SectionLabelStyle}" Margin="10,18,0,6" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Branches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BranchItemViewModel">
                                <Grid Height="28" Padding="12,0,10,0" CornerRadius="6" ColumnSpacing="9">
                                    <Grid.Background>
                                        <SolidColorBrush Color="{x:Bind RowBackground}" />
                                    </Grid.Background>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Fill><SolidColorBrush Color="{x:Bind DotColor}" /></Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Prefix}" Foreground="{StaticResource TextMutedBrush}" /><Run Text="{x:Bind Name}">
                                            <Run.Foreground><SolidColorBrush Color="{x:Bind NameColor}" /></Run.Foreground>
                                        </Run>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Badge}" FontSize="11.5" VerticalAlignment="Center">
                                        <TextBlock.Foreground><SolidColorBrush Color="{x:Bind BadgeColor}" /></TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3" Style="{StaticResource NavButtonStyle}" Height="Auto" Padding="10,9" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xF0E2;" FontSize="15" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="Repository Hub" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RepositoryHubText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Workspace: history above, inspector below; the split moves with the mode -->
            <Grid x:Name="Workspace" Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HistoryRow" Height="420" />
                    <RowDefinition x:Name="SplitterRow" Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- History -->
            <Grid x:Name="HistoryPane" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Padding="16,0,12,0">
                    <TextBlock Text="History" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="FilterBox" Width="300" Height="28" CornerRadius="6" FontSize="12" VerticalAlignment="Center"
                             Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnFilterKeyDown"
                             ToolTipService.ToolTip="Text matches message, author, hash or ref · author:name · path:src/file.cs (or any path with a slash)"
                             PlaceholderText="Filter by message, hash, author or path   (Ctrl+F)" AutomationProperties.Name="Filter commits" />
                    <TextBlock Text="{x:Bind ViewModel.CommitCountText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" Padding="8,0,16,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Graph" Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Description" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Author" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Date" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Commit" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="HistoryList" Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCommit, Mode=TwoWay}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource CommitItemStyle}"
                          AutomationProperties.Name="Commit history"
                          DoubleTapped="OnHistoryDoubleTapped"
                          PreviewKeyDown="OnHistoryPreviewKeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommitRowViewModel">
                            <Grid Height="26" Padding="8,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <graph:GraphCell Row="{x:Bind}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Padding="0,0,16,0">
                                    <ItemsControl ItemsSource="{x:Bind Refs}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RefChipViewModel">
                                                <Border Height="18" Padding="6,0" CornerRadius="4" BorderThickness="1">
                                                    <Border.Background><SolidColorBrush Color="{x:Bind Background}" /></Border.Background>
                                                    <Border.BorderBrush><SolidColorBrush Color="{x:Bind Border}" /></Border.BorderBrush>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11.5" VerticalAlignment="Center">
                                                        <TextBlock.Foreground><SolidColorBrush Color="{x:Bind Foreground}" /></TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                                        <TextBlock.Foreground><SolidColorBrush Color="{x:Bind SubjectColor}" /></TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Author}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Date}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ShortHash}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:Splitter x:Name="HistorySplitter" Grid.Row="1" />

            <!-- Inspector -->
            <Grid x:Name="InspectorPane" Grid.Row="2" Background="{StaticResource WindowBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DetailsColumn" Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="{x:Bind ViewModel.Inspector.EmptyText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600"
                           Visibility="{x:Bind ViewModel.Inspector.HasNoDetails, Mode=OneWay}" />

                <!-- Details -->
                <Grid x:Name="DetailsPane" BorderBrush="{StaticResource SeamBrush}" BorderThickness="0,0,1,0"
                      Visibility="{x:Bind ViewModel.Inspector.HasDetails, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,14,16,12" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.Inspector.Details.Subject, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Inspector.Details.Body, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.Inspector.Details.HasBody, Mode=OneWay}" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource ElevatedBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Inspector.Details.AuthorInitials, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind ViewModel.Inspector.Details.AuthorName, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Run Text="{x:Bind ViewModel.Inspector.Details.AuthorEmail, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind ViewModel.Inspector.Details.AuthorDate, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Inspector.Details.CommitterLine, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{x:Bind ViewModel.Inspector.Details.HasCommitter, Mode=OneWay}" TextWrapping="Wrap" />

                            <Grid RowSpacing="6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Commit" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.Inspector.Details.ShortHash, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="6,2" Click="OnCopyHash" ToolTipService.ToolTip="Copy full hash"
                                            AutomationProperties.Name="Copy full hash">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Inspector.Details.ParentsLabel, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Inspector.Details.Parents, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParentViewModel">
                                            <Button Style="{StaticResource GhostButtonStyle}" Padding="6,2" Tag="{x:Bind Hash}" Click="OnParentClick"
                                                    Background="{StaticResource RaisedBrush}" ToolTipService.ToolTip="Go to parent">
                                                <TextBlock Text="{x:Bind ShortHash}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="2" Text="Signature" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Inspector.Details.SignatureText, Mode=OneWay}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Foreground><SolidColorBrush Color="{x:Bind ViewModel.Inspector.Details.SignatureColor, Mode=OneWay}" /></TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Padding="16,6,16,6" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Inspector.Details.FilesSummary, Mode=OneWay}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Inspector.Details.AddedText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource GreenTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Inspector.Details.DeletedText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RedTextBrush}" />
                    </Grid>

                    <ListView x:Name="FileList" Grid.Row="2" Padding="0,0,0,8"
                              ItemsSource="{x:Bind ViewModel.Inspector.Details.Files, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Inspector.SelectedFile, Mode=TwoWay}"
                              SelectionMode="Single" ItemContainerStyle="{StaticResource FileItemStyle}"
                              AutomationProperties.Name="Changed files">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangedFileViewModel">
                                <Grid Padding="10,0" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Model.Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Letter}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Foreground><SolidColorBrush Color="{x:Bind LetterColor}" /></TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5">
                                        <Run Text="{x:Bind FileName}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Run Text="{x:Bind Directory}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AddedText}" FontSize="11.5" Foreground="{StaticResource GreenTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DeletedText}" FontSize="11.5" Foreground="{StaticResource RedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Diff -->
                <Grid x:Name="DiffPane" Grid.Column="1" Background="{StaticResource SurfaceBrush}" Visibility="{x:Bind ViewModel.Inspector.HasDetails, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="14,0,8,0" ColumnSpacing="10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run x:Name="FocusCommitRun" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <Run Text="{x:Bind ViewModel.Inspector.DiffTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="{x:Bind ViewModel.Inspector.DiffDirectory, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </TextBlock>

                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Inspector.ChangePosition, Mode=OneWay}" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButtonStyle}" Padding="7,4" Click="OnPreviousChange" ToolTipService.ToolTip="Previous change (Alt+Up)"
                                    AutomationProperties.Name="Previous change"><FontIcon Glyph="&#xE70E;" FontSize="11" /></Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Padding="7,4" Click="OnNextChange" ToolTipService.ToolTip="Next change (Alt+Down)"
                                    AutomationProperties.Name="Next change"><FontIcon Glyph="&#xE70D;" FontSize="11" /></Button>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{StaticResource DeepBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="SplitButton" Style="{StaticResource GhostButtonStyle}" Padding="10,3" Click="OnSplitClick" Content="Split" FontSize="12" />
                                <Button x:Name="UnifiedButton" Style="{StaticResource GhostButtonStyle}" Padding="10,3" Click="OnUnifiedClick" Content="Unified" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="FocusButton" Grid.Column="4" Style="{StaticResource GhostButtonStyle}" Padding="8,5" Click="OnFocusClick"
                                ToolTipService.ToolTip="Focus on the diff (Enter) · Esc to go back" AutomationProperties.Name="Focus on the diff">
                            <FontIcon x:Name="FocusGlyph" Glyph="&#xE740;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ListView x:Name="DiffList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Inspector.DiffRows, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource DiffRowSelector}"
                              ItemContainerStyle="{StaticResource DiffItemStyle}"
                              SelectionMode="None" IsItemClickEnabled="False"
                              AutomationProperties.Name="Diff" />

                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Inspector.DiffMessage, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.Inspector.HasDiffMessage, Mode=OneWay}" />
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <!-- ═══ Status bar ═══ -->
        <Grid Grid.Row="2" Background="{StaticResource DeepBrush}" BorderBrush="#FF0F1013" BorderThickness="0,1,0,0" Padding="12,0,12,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D5;" FontSize="12" Foreground="{StaticResource VioletBrush}" />
                <TextBlock Text="{x:Bind ViewModel.UpstreamSummary, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Rectangle Grid.Column="1" Width="1" Height="14" Fill="#FF2E3239" />
            <TextBlock x:Name="StatusLine" Grid.Column="2" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="CentralGit 0.1 · preview" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
